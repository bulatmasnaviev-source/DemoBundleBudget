{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">To-Do list</h3>
        </div>
        <div class="card-body">
            <h4 class="display-6 fw-bold mb-3">To-Do list</h4>

            <section class="mb-5">
                <h5 class="fw-bold mb-3">Добавить инициацию</h5>
                <div class="todo-form-grid mb-3">
                    <div>
                        <label class="form-label" for="todoBlock">Блок</label>
                        <select id="todoBlock" class="form-select">
                            <option value=""></option>
                            <option value="Проекты">Проект</option>
                            <option value="Исследования">Исследование</option>
                            <option value="PR">PR</option>
                            <option value="G&A">G&amp;A</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="todoStage">Этап</label>
                        <input id="todoStage" class="form-control todo-stage-field" type="text" value="Инициация" readonly>
                    </div>
                    <div>
                        <label class="form-label" for="todoSubstage">Подэтап</label>
                        <select id="todoSubstage" class="form-select">
                            <option value=""></option>
                            <option value="Инициация темы">Инициация темы</option>
                            <option value="Разработка ТЗ">Разработка ТЗ</option>
                            <option value="Подготовка закупки">Подготовка закупки</option>
                            <option value="Формирование КП">Формирование КП</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="todoProject">Проект</label>
                        <textarea id="todoProject" class="form-control todo-auto-field" rows="1"></textarea>
                    </div>
                    <div>
                        <label class="form-label" for="todoTask">Задача</label>
                        <textarea id="todoTask" class="form-control todo-auto-field" rows="1"></textarea>
                    </div>
                    <div>
                        <label class="form-label" for="todoTaskStatus">Статус по задаче</label>
                        <textarea id="todoTaskStatus" class="form-control todo-auto-field" rows="1"></textarea>
                    </div>
                    <div>
                        <label class="form-label" for="todoNextStep">Следующий шаг</label>
                        <textarea id="todoNextStep" class="form-control todo-auto-field" rows="1"></textarea>
                    </div>
                    <div>
                        <label class="form-label" for="todoResponsible">Ответственный</label>
                        <textarea id="todoResponsible" class="form-control todo-auto-field" rows="1"></textarea>
                    </div>
                    <div>
                        <label class="form-label" for="todoDate">Дата</label>
                        <input id="todoDate" class="form-control" type="date">
                    </div>
                </div>
                <button id="todoSubmitButton" type="button" class="btn btn-outline-dark mb-3">Отправить</button>
                <div class="d-flex flex-wrap gap-2">
                    <button id="todoEditButton" type="button" class="btn btn-outline-dark" title="Редактировать"><i class="fas fa-pencil-alt"></i></button>
                    <button id="todoSaveButton" type="button" class="btn btn-outline-dark">Сохранить</button>
                    <button id="todoNextStageButton" type="button" class="btn btn-outline-dark">Следующий этап</button>
                    <button id="todoPreviousStageButton" type="button" class="btn btn-outline-dark">Предыдущий этап</button>
                    <button id="todoCancelButton" type="button" class="btn btn-outline-dark">Отменить</button>
                    <button id="todoReturnButton" type="button" class="btn btn-outline-dark">Вернуть задачу</button>
                </div>
            </section>

            <section class="mb-5">
                <h5 class="fw-bold mb-3">Проекты (инициации)</h5>
                <div class="table-responsive todo-table-shell">
                    <table class="table table-bordered align-middle mb-0 todo-data-table">
                        <thead id="todoProjectsHead"></thead>
                        <tbody id="todoProjectsBody"></tbody>
                    </table>
                </div>
            </section>

            <section class="mb-5">
                <h5 class="fw-bold mb-3">Проекты (реализация)</h5>
                <div class="table-responsive todo-table-shell">
                    <table class="table table-bordered align-middle mb-0 todo-data-table">
                        <thead id="todoProjectExecutionHead"></thead>
                        <tbody id="todoProjectExecutionBody"></tbody>
                    </table>
                </div>
            </section>

            <section class="mb-5">
                <h5 class="fw-bold mb-3">Исследования, PR и G&amp;A</h5>
                <div class="table-responsive todo-table-shell">
                    <table class="table table-bordered align-middle mb-0 todo-data-table">
                        <thead id="todoResearchHead"></thead>
                        <tbody id="todoResearchBody"></tbody>
                    </table>
                </div>
            </section>

            <section class="mb-5">
                <h5 class="fw-bold mb-3">Завершенные проекты</h5>
                <div class="table-responsive todo-table-shell">
                    <table class="table table-bordered align-middle mb-0 todo-data-table">
                        <thead id="todoCompletedHead"></thead>
                        <tbody id="todoCompletedBody"></tbody>
                    </table>
                </div>
            </section>

            <section>
                <h5 class="fw-bold mb-3">Отменено</h5>
                <div class="table-responsive todo-table-shell">
                    <table class="table table-bordered align-middle mb-0 todo-data-table">
                        <thead id="todoCancelledHead"></thead>
                        <tbody id="todoCancelledBody"></tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>

    <div id="todoCancelModal" class="todo-modal-backdrop" hidden>
        <div class="todo-modal">
            <h5 class="fw-bold mb-3">Выберите причину отмены инициации</h5>
            <textarea id="todoCancelReason" class="form-control mb-3" rows="4"></textarea>
            <div class="d-flex justify-content-end gap-2">
                <button id="todoCancelCloseButton" type="button" class="btn btn-outline-secondary">Закрыть</button>
                <button id="todoCancelSubmitButton" type="button" class="btn btn-outline-dark">Отправить</button>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .todo-form-grid {
            display: grid;
            grid-template-columns: repeat(9, minmax(0, 1fr));
            gap: 0.75rem;
            align-items: start;
        }

        .todo-stage-field {
            background-color: #e9ecef;
            color: #495057;
        }

        .todo-auto-field {
            width: 100%;
            min-height: 2.375rem;
            resize: vertical;
            overflow-y: hidden;
        }

        .todo-table-shell {
            min-height: calc(5 * 2.75rem + 3rem);
            max-height: calc(50 * 2.75rem + 3rem);
            overflow-y: auto;
        }

        .todo-data-table {
            table-layout: fixed;
            width: 100%;
        }

        .todo-data-table thead th {
            position: sticky;
            top: 0;
            background: #f8f9fa;
            z-index: 1;
        }

        .todo-data-table th,
        .todo-data-table td {
            white-space: normal;
            word-break: break-word;
            vertical-align: top;
        }

        .todo-data-table td:nth-child(1),
        .todo-data-table th:nth-child(1) {
            width: 5rem;
        }

        .todo-data-table td:nth-child(2),
        .todo-data-table th:nth-child(2),
        .todo-data-table td:nth-child(3),
        .todo-data-table th:nth-child(3),
        .todo-data-table td:nth-child(9),
        .todo-data-table th:nth-child(9) {
            width: 8rem;
        }

        .todo-data-table td:nth-child(4),
        .todo-data-table th:nth-child(4),
        .todo-data-table td:nth-child(8),
        .todo-data-table th:nth-child(8) {
            width: 10rem;
        }

        .todo-empty-row td {
            height: 2.75rem;
            background: #fff;
        }

        .todo-selected-row td {
            background-color: #fff3cd;
        }

        .todo-row-edit-field,
        .todo-row-edit-select,
        .todo-row-edit-date {
            width: 100%;
            min-height: 2.25rem;
            resize: vertical;
        }

        .todo-modal-backdrop {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            background: rgba(0, 0, 0, 0.45);
            z-index: 2000;
        }

        .todo-modal {
            width: min(100%, 34rem);
            background: #fff;
            border-radius: 0.75rem;
            padding: 1.25rem;
            box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.2);
        }

        @media (max-width: 1800px) {
            .todo-form-grid {
                grid-template-columns: repeat(5, minmax(0, 1fr));
            }
        }

        @media (max-width: 1200px) {
            .todo-form-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @media (max-width: 768px) {
            .todo-form-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const createUrl = '{{ path('demo_todo_list_create') }}';
            const dataUrl = '{{ path('demo_todo_list_data') }}';
            const updateUrlTemplate = '{{ path('demo_todo_list_update', {'id': 'ENTRY_ID'}) }}';
            const updateStageUrlTemplate = '{{ path('demo_todo_list_update_stage', {'id': 'ENTRY_ID'}) }}';
            const cancelUrlTemplate = '{{ path('demo_todo_list_cancel', {'id': 'ENTRY_ID'}) }}';
            const defaultColumns = ['ID', 'Блок', 'Этап', 'Проект', 'Задача', 'Статус по задаче', 'Следующий шаг', 'Ответственный', 'Дата'];
            const sectionColumns = {
                projectInitiations: ['ID', 'Блок', 'Этап', 'Подэтап', 'Проект', 'Задача', 'Статус по задаче', 'Следующий шаг', 'Ответственный', 'Дата'],
                projectExecution: defaultColumns,
                research: defaultColumns,
                completed: defaultColumns,
                cancelled: ['ID', 'Блок', 'Этап', 'Проект', 'Задача', 'Статус по задаче', 'Следующий шаг', 'Ответственный', 'Дата', 'Причина отмены'],
            };
            const blockOptions = [
                {value: 'Проекты', label: 'Проект'},
                {value: 'Исследования', label: 'Исследование'},
                {value: 'PR', label: 'PR'},
                {value: 'G&A', label: 'G&A'},
            ];
            const stageSequence = ['Инициация', 'Реализация', 'Завершение', 'Завершено'];
            const sectionMap = {
                projectInitiations: { head: document.getElementById('todoProjectsHead'), body: document.getElementById('todoProjectsBody') },
                projectExecution: { head: document.getElementById('todoProjectExecutionHead'), body: document.getElementById('todoProjectExecutionBody') },
                research: { head: document.getElementById('todoResearchHead'), body: document.getElementById('todoResearchBody') },
                completed: { head: document.getElementById('todoCompletedHead'), body: document.getElementById('todoCompletedBody') },
                cancelled: { head: document.getElementById('todoCancelledHead'), body: document.getElementById('todoCancelledBody') },
            };
            const state = {
                buckets: {
                    projectInitiations: [],
                    projectExecution: [],
                    research: [],
                    completed: [],
                    cancelled: [],
                },
                selectedRowId: null,
                editingRowId: null,
                editDraft: null,
            };

            const blockField = document.getElementById('todoBlock');
            const stageField = document.getElementById('todoStage');
            const substageField = document.getElementById('todoSubstage');
            const projectField = document.getElementById('todoProject');
            const taskField = document.getElementById('todoTask');
            const taskStatusField = document.getElementById('todoTaskStatus');
            const nextStepField = document.getElementById('todoNextStep');
            const responsibleField = document.getElementById('todoResponsible');
            const dateField = document.getElementById('todoDate');
            const submitButton = document.getElementById('todoSubmitButton');
            const editButton = document.getElementById('todoEditButton');
            const saveButton = document.getElementById('todoSaveButton');
            const nextStageButton = document.getElementById('todoNextStageButton');
            const previousStageButton = document.getElementById('todoPreviousStageButton');
            const cancelButton = document.getElementById('todoCancelButton');
            const returnButton = document.getElementById('todoReturnButton');
            const cancelModal = document.getElementById('todoCancelModal');
            const cancelReasonField = document.getElementById('todoCancelReason');
            const cancelCloseButton = document.getElementById('todoCancelCloseButton');
            const cancelSubmitButton = document.getElementById('todoCancelSubmitButton');

            function getUpdateUrl(id) {
                return updateUrlTemplate.replace('ENTRY_ID', String(id));
            }

            function getStageUpdateUrl(id) {
                return updateStageUrlTemplate.replace('ENTRY_ID', String(id));
            }

            function getCancelUrl(id) {
                return cancelUrlTemplate.replace('ENTRY_ID', String(id));
            }

            function escapeHtml(value) {
                return String(value ?? '')
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function formatDate(value) {
                if (typeof value !== 'string' || value.trim() === '') {
                    return '';
                }

                const parts = value.split('-');
                if (parts.length !== 3) {
                    return value;
                }

                return `${parts[2]}.${parts[1]}.${parts[0]}`;
            }
            function createHeaderHtml(sectionKey) {
                const columns = sectionColumns[sectionKey] ?? defaultColumns;
                return `<tr>${columns.map((column) => `<th>${column}</th>`).join('')}<\/tr>`;
            }

            function findEntryById(id) {
                const searchId = Number(id);
                for (const entries of Object.values(state.buckets)) {
                    const found = entries.find((entry) => Number(entry.id) === searchId);
                    if (found) {
                        return found;
                    }
                }

                return null;
            }

            function hasEntry(id) {
                return findEntryById(id) !== null;
            }

            function getSelectedEntry() {
                return state.selectedRowId === null ? null : findEntryById(state.selectedRowId);
            }

            function createBlockSelect(selectedValue) {
                const options = blockOptions.map((option) => {
                    const selected = option.value === selectedValue ? ' selected' : '';
                    return `<option value="${escapeHtml(option.value)}"${selected}>${escapeHtml(option.label)}</option>`;
                }).join('');

                return `<select class="form-select todo-row-edit-select" data-field="block">${options}</select>`;
            }

            function createEditTextarea(field, value) {
                return `<textarea class="form-control todo-row-edit-field" rows="1" data-field="${field}">${escapeHtml(value)}</textarea>`;
            }

            function createEditDate(field, value) {
                return `<input class="form-control todo-row-edit-date" type="date" data-field="${field}" value="${escapeHtml(value)}">`;
            }
            function createRowHtml(sectionKey, entry) {
                const isSelected = Number(state.selectedRowId) === Number(entry.id);
                const isEditing = Number(state.editingRowId) === Number(entry.id);
                const rowClass = isSelected ? 'todo-selected-row' : '';
                const draft = isEditing && state.editDraft ? state.editDraft : entry;

                const cells = [
                    `<td>${escapeHtml(entry.id)}</td>`,
                    `<td>${isEditing ? createBlockSelect(draft.block) : escapeHtml(entry.block)}</td>`,
                    `<td>${escapeHtml(entry.stage)}</td>`,
                ];

                if (sectionKey === 'projectInitiations') {
                    cells.push(`<td>${escapeHtml(entry.substage || '')}</td>`);
                }

                cells.push(
                    `<td>${isEditing ? createEditTextarea('project', draft.project) : escapeHtml(entry.project)}</td>`,
                    `<td>${isEditing ? createEditTextarea('task', draft.task) : escapeHtml(entry.task)}</td>`,
                    `<td>${isEditing ? createEditTextarea('taskStatus', draft.taskStatus) : escapeHtml(entry.taskStatus)}</td>`,
                    `<td>${isEditing ? createEditTextarea('nextStep', draft.nextStep) : escapeHtml(entry.nextStep)}</td>`,
                    `<td>${isEditing ? createEditTextarea('responsible', draft.responsible) : escapeHtml(entry.responsible)}</td>`,
                    `<td>${isEditing ? createEditDate('date', draft.date) : escapeHtml(formatDate(entry.date))}</td>`,
                );

                if (sectionKey === 'cancelled') {
                    cells.push(`<td>${escapeHtml(entry.cancelReason || '')}</td>`);
                }

                return `
                    <tr class="${rowClass}" data-entry-id="${entry.id}">
                        ${cells.join('')}
                    </tr>
                `;
            }

            function renderSection(sectionKey, entries) {
                const section = sectionMap[sectionKey];
                if (!section) {
                    return;
                }

                const columns = sectionColumns[sectionKey] ?? defaultColumns;
                section.head.innerHTML = createHeaderHtml(sectionKey);

                const normalizedEntries = Array.isArray(entries) ? entries : [];
                const rows = normalizedEntries.map((entry) => createRowHtml(sectionKey, entry));
                const emptyRows = Math.max(0, 5 - normalizedEntries.length);
                for (let i = 0; i < emptyRows; i++) {
                    rows.push(`<tr class="todo-empty-row">${'<td></td>'.repeat(columns.length)}</tr>`);
                }

                section.body.innerHTML = rows.join('');
            }

            function renderAllSections() {
                renderSection('projectInitiations', state.buckets.projectInitiations ?? []);
                renderSection('projectExecution', state.buckets.projectExecution ?? []);
                renderSection('research', state.buckets.research ?? []);
                renderSection('completed', state.buckets.completed ?? []);
                renderSection('cancelled', state.buckets.cancelled ?? []);
                initAutoResize(document.querySelectorAll('.todo-row-edit-field'));
            }

            async function loadTodoTables() {
                const response = await fetch(dataUrl);
                if (!response.ok) {
                    throw new Error('Failed to load todo list data');
                }

                const payload = await response.json();
                state.buckets = {
                    projectInitiations: Array.isArray(payload.projectInitiations) ? payload.projectInitiations : [],
                    projectExecution: Array.isArray(payload.projectExecution) ? payload.projectExecution : [],
                    research: Array.isArray(payload.research) ? payload.research : [],
                    completed: Array.isArray(payload.completed) ? payload.completed : [],
                    cancelled: Array.isArray(payload.cancelled) ? payload.cancelled : [],
                };

                if (state.selectedRowId !== null && !hasEntry(state.selectedRowId)) {
                    state.selectedRowId = null;
                }
                if (state.editingRowId !== null && !hasEntry(state.editingRowId)) {
                    state.editingRowId = null;
                    state.editDraft = null;
                }

                renderAllSections();
            }

            function getPayload() {
                return {
                    block: String(blockField.value || '').trim(),
                    stage: String(stageField.value || '').trim(),
                    substage: String(substageField.value || '').trim(),
                    project: String(projectField.value || '').trim(),
                    task: String(taskField.value || '').trim(),
                    taskStatus: String(taskStatusField.value || '').trim(),
                    nextStep: String(nextStepField.value || '').trim(),
                    responsible: String(responsibleField.value || '').trim(),
                    date: String(dateField.value || '').trim(),
                };
            }

            function hasEmptyValues(payload) {
                return Object.values(payload).some((value) => String(value).trim() === '');
            }

            function resetForm() {
                blockField.value = '';
                stageField.value = 'Инициация';
                substageField.value = '';
                projectField.value = '';
                taskField.value = '';
                taskStatusField.value = '';
                nextStepField.value = '';
                responsibleField.value = '';
                dateField.value = '';
                initAutoResize(document.querySelectorAll('.todo-auto-field'));
            }

            function initAutoResize(elements) {
                elements.forEach((element) => {
                    if (!(element instanceof HTMLTextAreaElement)) {
                        return;
                    }

                    element.style.height = 'auto';
                    element.style.height = `${element.scrollHeight}px`;
                });
            }

            function startEditingSelectedRow() {
                const entry = getSelectedEntry();
                if (!entry) {
                    return;
                }

                state.editingRowId = entry.id;
                state.editDraft = {
                    id: entry.id,
                    block: entry.block,
                    stage: entry.stage,
                    substage: entry.substage || '',
                    project: entry.project,
                    task: entry.task,
                    taskStatus: entry.taskStatus,
                    nextStep: entry.nextStep,
                    responsible: entry.responsible,
                    date: entry.date,
                };

                substageField.value = state.editDraft.substage;
                renderAllSections();
            }

            async function saveEditedRow() {
                if (state.editingRowId === null || state.editDraft === null) {
                    return;
                }

                state.editDraft.substage = String(substageField.value || '').trim();

                const payload = {
                    block: String(state.editDraft.block || '').trim(),
                    substage: String(state.editDraft.substage || '').trim(),
                    project: String(state.editDraft.project || '').trim(),
                    task: String(state.editDraft.task || '').trim(),
                    taskStatus: String(state.editDraft.taskStatus || '').trim(),
                    nextStep: String(state.editDraft.nextStep || '').trim(),
                    responsible: String(state.editDraft.responsible || '').trim(),
                    date: String(state.editDraft.date || '').trim(),
                };

                if (hasEmptyValues(payload)) {
                    alert('Все поля должны быть заполнены');
                    return;
                }

                const response = await fetch(getUpdateUrl(state.editingRowId), {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload),
                });

                if (response.status === 422) {
                    alert('Все поля должны быть заполнены');
                    return;
                }

                if (!response.ok) {
                    alert('Не удалось обновить запись');
                    return;
                }

                const selectedId = state.selectedRowId;
                state.editingRowId = null;
                state.editDraft = null;
                resetForm();
                await loadTodoTables();
                state.selectedRowId = selectedId;
                renderAllSections();
            }

            function getNextStage(currentStage) {
                if (currentStage === 'Отменено') {
                    return currentStage;
                }

                const currentIndex = stageSequence.indexOf(currentStage);
                if (currentIndex === -1 || currentIndex === stageSequence.length - 1) {
                    return currentStage;
                }

                return stageSequence[currentIndex + 1];
            }

            function getPreviousStage(currentStage) {
                if (currentStage === 'Отменено') {
                    return currentStage;
                }

                const currentIndex = stageSequence.indexOf(currentStage);
                if (currentIndex <= 0) {
                    return currentStage;
                }

                return stageSequence[currentIndex - 1];
            }

            async function updateSelectedStage(targetStage) {
                const entry = getSelectedEntry();
                if (!entry || entry.stage === targetStage) {
                    return;
                }

                const response = await fetch(getStageUpdateUrl(entry.id), {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({stage: targetStage}),
                });

                if (!response.ok) {
                    alert('Не удалось обновить этап');
                    return;
                }

                const selectedId = state.selectedRowId;
                state.editingRowId = null;
                state.editDraft = null;
                await loadTodoTables();
                state.selectedRowId = selectedId;
                renderAllSections();
            }

            function openCancelModal() {
                cancelReasonField.value = '';
                cancelModal.hidden = false;
                cancelReasonField.focus();
            }

            function closeCancelModal() {
                cancelModal.hidden = true;
                cancelReasonField.value = '';
            }

            async function submitCancellation() {
                const entry = getSelectedEntry();
                if (!entry) {
                    return;
                }

                const reason = String(cancelReasonField.value || '').trim();
                if (reason === '') {
                    alert('Все поля должны быть заполнены');
                    return;
                }

                const response = await fetch(getCancelUrl(entry.id), {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({reason}),
                });

                if (response.status === 422) {
                    alert('Все поля должны быть заполнены');
                    return;
                }

                if (!response.ok) {
                    alert('Не удалось отменить запись');
                    return;
                }

                const selectedId = state.selectedRowId;
                closeCancelModal();
                state.editingRowId = null;
                state.editDraft = null;
                await loadTodoTables();
                state.selectedRowId = selectedId;
                renderAllSections();
            }

            Object.values(sectionMap).forEach((section) => {
                section.body.addEventListener('click', function (event) {
                    const row = event.target.closest('tr[data-entry-id]');
                    if (!row) {
                        return;
                    }

                    const clickedId = Number(row.dataset.entryId);
                    if (state.selectedRowId === clickedId && state.editingRowId === clickedId) {
                        return;
                    }

                    state.selectedRowId = clickedId;
                    if (state.editingRowId !== null && state.editingRowId !== state.selectedRowId) {
                        state.editingRowId = null;
                        state.editDraft = null;
                    }
                    renderAllSections();
                });

                section.body.addEventListener('input', function (event) {
                    if (state.editingRowId === null || state.editDraft === null) {
                        return;
                    }

                    const field = String(event.target.dataset.field || '');
                    if (field === '') {
                        return;
                    }

                    state.editDraft[field] = event.target.value;
                    initAutoResize([event.target]);
                });

                section.body.addEventListener('change', function (event) {
                    if (state.editingRowId === null || state.editDraft === null) {
                        return;
                    }

                    const field = String(event.target.dataset.field || '');
                    if (field === '') {
                        return;
                    }

                    state.editDraft[field] = event.target.value;
                });
            });

            document.querySelectorAll('.todo-auto-field').forEach((field) => {
                field.addEventListener('input', function () {
                    initAutoResize([field]);
                });
            });

            submitButton.addEventListener('click', async function () {
                const payload = getPayload();
                if (hasEmptyValues(payload)) {
                    alert('Все поля должны быть заполнены');
                    return;
                }

                const response = await fetch(createUrl, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload),
                });

                if (response.status === 422) {
                    alert('Все поля должны быть заполнены');
                    return;
                }

                if (!response.ok) {
                    alert('Не удалось создать запись');
                    return;
                }

                resetForm();
                await loadTodoTables();
            });

            editButton.addEventListener('click', function () {
                startEditingSelectedRow();
            });

            saveButton.addEventListener('click', async function () {
                await saveEditedRow();
            });

            nextStageButton.addEventListener('click', async function () {
                const entry = getSelectedEntry();
                if (!entry || entry.stage === 'Отменено') {
                    return;
                }

                await updateSelectedStage(getNextStage(entry.stage));
            });

            previousStageButton.addEventListener('click', async function () {
                const entry = getSelectedEntry();
                if (!entry || entry.stage === 'Отменено') {
                    return;
                }

                await updateSelectedStage(getPreviousStage(entry.stage));
            });

            cancelButton.addEventListener('click', function () {
                const entry = getSelectedEntry();
                if (!entry) {
                    return;
                }

                openCancelModal();
            });

            returnButton.addEventListener('click', async function () {
                const entry = getSelectedEntry();
                if (!entry || entry.stage !== 'Отменено') {
                    return;
                }

                await updateSelectedStage('Инициация');
            });

            cancelCloseButton.addEventListener('click', function () {
                closeCancelModal();
            });

            cancelSubmitButton.addEventListener('click', async function () {
                await submitCancellation();
            });

            cancelModal.addEventListener('click', function (event) {
                if (event.target === cancelModal) {
                    closeCancelModal();
                }
            });

            initAutoResize(document.querySelectorAll('.todo-auto-field'));
            loadTodoTables().catch(() => {
                alert('Не удалось загрузить To-Do list');
            });
        })();
    </script>
{% endblock %}
