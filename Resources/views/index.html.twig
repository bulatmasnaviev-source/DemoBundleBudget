{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" id="mainTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="management-tab" data-bs-toggle="tab" data-bs-target="#management-pane" type="button" role="tab">Менеджмент затрат</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="resource-tab" data-bs-toggle="tab" data-bs-target="#resource-pane" type="button" role="tab">Ресурсный план</button>
                </li>
            </ul>
        </div>
        <div class="card-body tab-content">
            <div class="tab-pane fade show active" id="management-pane" role="tabpanel">
                <div class="mb-4">
                    <h4 class="fs-4 fw-bold mb-2">Активные проекты и статус базового плана</h4>
                    <div class="table-responsive" style="max-height: 760px; overflow-y: auto;">
                        <table class="table table-sm table-bordered mb-0">
                            <thead><tr><th>Проект</th><th>Статус</th></tr></thead>
                            <tbody id="activeStatusTableBody">
                            {% for item in active_project_statuses %}
                                {% set color = item.status == 'APPROVED' ? '#198754' : (item.status == 'SENT' ? '#6c757d' : (item.status == 'REJECTED' ? '#ffc107' : '#000000')) %}
                                {% set label = item.status == 'APPROVED' ? 'Согласовано' : (item.status == 'SENT' ? 'Отправлено' : (item.status == 'REJECTED' ? 'Отклонено' : 'Новый')) %}
                                <tr data-project-id="{{ item.id }}"><td>{{ item.name }}</td><td style="color: {{ color }};">{{ label }}</td></tr>
                            {% else %}
                                <tr><td colspan="2">Нет активных проектов</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="projectSelect">Проект</label>
                        <select id="projectSelect" class="form-select">
                            {% for project in projects %}<option value="{{ project.id }}">{{ project.name }}</option>{% else %}<option value="">Нет доступных проектов</option>{% endfor %}
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-2"><label class="form-label">Дата начала проекта</label><div id="projectStartDateLabel" class="form-control-plaintext border rounded px-2 py-2 bg-light">—</div></div>
                    <div class="col-md-2"><label class="form-label">Дата окончания проекта</label><div id="projectEndDateLabel" class="form-control-plaintext border rounded px-2 py-2 bg-light">—</div></div>
                    <div class="col-md-2"><label class="form-label">Бюджет проекта</label><div id="projectBudgetLabel" class="form-control-plaintext border rounded px-2 py-2 bg-light">0</div></div>
                </div>

                <div class="d-flex align-items-center gap-2 mb-2"><strong>Статус базового плана:</strong><span id="planStatusLabel" class="fw-bold">Новый</span></div>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button id="sendForApprovalButton" type="button" class="btn btn-secondary">Отправить на согласование</button>
                    <button id="approvePlanButton" type="button" class="btn btn-success" {% if not is_admin %}disabled{% endif %}>Согласовать</button>
                    <button id="rejectPlanButton" type="button" class="btn btn-warning" {% if not is_admin %}disabled{% endif %}>Отклонено</button>
                </div>

                <div class="table-responsive"><table class="table table-bordered align-middle" id="budgetTable" style="table-layout: fixed; width: auto;"><thead id="budgetTableHead"></thead><tbody id="budgetTableBody"></tbody><tfoot><tr id="summaryRow"><th colspan="3">Сумма (ставка × часы)</th></tr></tfoot></table></div>
                <div class="d-flex flex-column align-items-start gap-2 mt-3"><button id="addRowButton" type="button" class="btn btn-outline-primary">+</button><button id="buildChartButton" type="button" class="btn btn-success">OK</button></div>
                <div class="table-responsive mt-3"><table class="table table-bordered align-middle" id="actualTable" style="table-layout: fixed; width: auto;"><thead id="actualTableHead"></thead><tbody id="actualTableBody"></tbody><tfoot><tr id="actualSummaryRow"><th colspan="3">Факт (часы × ставка)</th></tr></tfoot></table></div>
                <div class="mt-4"><h4 class="h5 mb-2">Сравнение базового плана и фактического расхода бюджета</h4><svg id="budgetChart" style="width:100%;height:360px"></svg></div>
            </div>

            <div class="tab-pane fade" id="resource-pane" role="tabpanel">
                <h3 class="mb-3">Ресурсное планирование</h3>
                <label class="form-label">Выбор интервала планирования</label>
                <select id="resourceIntervalSelect" class="form-select mb-3" style="max-width: 280px;"></select>
                <div class="d-flex align-items-center gap-2 mb-2"><strong>Статус:</strong><span id="resourceStatusLabel">Новое</span></div>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button id="resourceDiscussButton" class="btn btn-secondary" type="button">На обсуждение</button>
                    <button id="resourceRejectButton" class="btn btn-warning" type="button">Отклонено</button>
                    <button id="resourceApproveButton" class="btn btn-success" type="button">Согласовать</button>
                </div>
                <div class="table-responsive"><table class="table table-bordered" id="resourceTable"><thead id="resourceTableHead"></thead><tbody id="resourceTableBody"></tbody></table></div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const projects = {{ project_data|json_encode|raw }};
            const employees = {{ employees|json_encode|raw }};
            const resourceIntervals = {{ resource_intervals|json_encode|raw }};
            const isAdmin = {{ is_admin ? 'true' : 'false' }};
            const planGetUrlTemplate = '{{ path('demo_budget_plan_get', {project:'__PROJECT_ID__'}) }}';
            const planStatusUrlTemplate = '{{ path('demo_budget_plan_status', {project:'__PROJECT_ID__'}) }}';
            const actualCostsUrlTemplate = '{{ path('demo_budget_plan_actual_costs', {project:'__PROJECT_ID__'}) }}';
            const resourceGetUrlTemplate = '{{ path('demo_resource_plan_get', {intervalStart:'__INTERVAL__'}) }}';
            const resourceStatusUrlTemplate = '{{ path('demo_resource_plan_status', {intervalStart:'__INTERVAL__'}) }}';
            const approvedResourceUrlTemplate = '{{ path('demo_resource_plan_project_approved', {project:'__PROJECT_ID__', intervalStart:'__INTERVAL__'}) }}';

            const STATUS = { NEW:{label:'Новый', color:'#000', locked:false}, SENT:{label:'Отправлено', color:'#6c757d', locked:true}, APPROVED:{label:'Согласовано', color:'#198754', locked:true}, REJECTED:{label:'Отклонено', color:'#ffc107', locked:false} };
            const RESOURCE_STATUS = { NEW:{label:'Новое', locked:false}, IN_DISCUSSION:{label:'На обсуждении', locked:true}, REJECTED:{label:'Отклонено', locked:false}, APPROVED:{label:'Согласовано', locked:true} };

            const state = { activeProject:null, status:'NEW', periods:[], actualMatrix:{}, actualTotals:[], activeBudget:0, actualEdits:{}, approvedResourceHours:{}, approvedResourceLocked:false };
            const resourceState = { intervalStart:null, status:'NEW', rows:[] };

            const employeeMap = new Map(employees.map(e => [String(e.id), e]));
            const tableBody = document.getElementById('budgetTableBody');
            const tableHead = document.getElementById('budgetTableHead');
            const summaryRow = document.getElementById('summaryRow');
            const actualTableBody = document.getElementById('actualTableBody');
            const actualTableHead = document.getElementById('actualTableHead');
            const actualSummaryRow = document.getElementById('actualSummaryRow');

            const getPlanUrl = (tpl, id) => tpl.replace('__PROJECT_ID__', encodeURIComponent(String(id)));
            const getResourceUrl = (tpl, start) => tpl.replace('__INTERVAL__', encodeURIComponent(String(start)));
            const getApprovedResourceUrl = (projectId, start) => approvedResourceUrlTemplate.replace('__PROJECT_ID__', encodeURIComponent(String(projectId))).replace('__INTERVAL__', encodeURIComponent(String(start)));
            const toShortName = (name) => { const p = String(name || '').trim().split(/\s+/); return p.length >= 2 ? `${p[0]} ${p[1].charAt(0)}.` : String(name || ''); };

            function formatPeriodLabel(startDate) {
                const s = new Date(startDate + 'T00:00:00');
                const e = new Date(s); e.setDate(e.getDate() + 13);
                const f = (d) => `${String(d.getDate()).padStart(2,'0')}.${String(d.getMonth()+1).padStart(2,'0')}`;
                return `${f(s)}\n${f(e)}`;
            }

            function buildPeriods() {
                const start = new Date(state.activeProject.start + 'T00:00:00');
                const end = new Date(state.activeProject.end + 'T00:00:00');
                const periodStart = new Date(start); periodStart.setDate(periodStart.getDate() - (((periodStart.getDay()+6)%7) + 7));
                const periodEnd = new Date(end); periodEnd.setDate(periodEnd.getDate() + (7-((periodEnd.getDay()+6)%7)) + 14);
                const periods = [];
                for (let c = new Date(periodStart); c <= periodEnd; c.setDate(c.getDate()+14)) {
                    periods.push({start: c.toISOString().slice(0,10), label: formatPeriodLabel(c.toISOString().slice(0,10))});
                }
                return periods;
            }

            function currentPeriodIndex() {
                const now = new Date();
                return state.periods.findIndex((p) => {
                    const s = new Date(p.start + 'T00:00:00'); const e = new Date(s); e.setDate(e.getDate()+13); e.setHours(23,59,59,999);
                    return now >= s && now <= e;
                });
            }

            function createEmployeeOptions() { return employees.map((e) => `<option value="${e.id}">${e.name}</option>`).join(''); }
            function getEmployeeMeta(id) { const e = employeeMap.get(String(id)); return {id:String(id), name:e?.name || `Пользователь_${id}`, rate:Math.round(Number(e?.hourlyRate||0))}; }
            function updateRowRate(row) { const e = employeeMap.get(String(row.querySelector('.employee-select').value)); const r=Number(e?.hourlyRate||0); row.dataset.rate=String(r); row.querySelector('.rate-label').textContent=String(Math.round(r)); }

            function createRow(initialEmployeeId = null, hourValues = []) {
                const tr = document.createElement('tr'); tr.dataset.rate='0';
                tr.innerHTML = `<td><select class="form-select employee-select">${createEmployeeOptions()}</select></td><td><span class="rate-label">0</span></td>`;
                for (let i=0;i<state.periods.length;i++) tr.insertAdjacentHTML('beforeend', `<td style="min-width:9rem;"><input type="number" min="0" step="0.1" class="form-control hour-input" value="${hourValues[i] ?? '0'}"></td>`);
                tr.insertAdjacentHTML('beforeend', '<td><button type="button" class="btn btn-sm btn-danger row-remove-button">✖</button></td>');
                tableBody.appendChild(tr);
                const sel = tr.querySelector('.employee-select');
                sel.value = initialEmployeeId !== null ? String(initialEmployeeId) : (employees[0] ? String(employees[0].id) : '');
                updateRowRate(tr);
            }

            function renderHeaders() {
                tableHead.innerHTML=''; actualTableHead.innerHTML='';
                summaryRow.querySelectorAll('td').forEach(e=>e.remove()); actualSummaryRow.querySelectorAll('td').forEach(e=>e.remove());
                const hr = document.createElement('tr'); hr.innerHTML='<th>ФИО сотрудника</th><th>Часовая ставка</th>';
                const hr2 = document.createElement('tr'); hr2.innerHTML='<th>ФИО сотрудника</th><th>Часовая ставка</th>';
                const currentIdx = currentPeriodIndex();
                state.periods.forEach((p, idx) => {
                    hr.insertAdjacentHTML('beforeend', `<th style="white-space:pre-line;min-width:9rem;">${p.label}</th>`);
                    hr2.insertAdjacentHTML('beforeend', `<th style="white-space:pre-line;min-width:9rem;${idx===currentIdx?'background:#fff8c5;':''}">${p.label}</th>`);
                    summaryRow.insertAdjacentHTML('beforeend', '<td class="summary-cell">0</td>');
                    actualSummaryRow.insertAdjacentHTML('beforeend', `<td class="actual-summary-cell" style="${idx===currentIdx?'background:#fff8c5;':''}">0</td>`);
                });
                hr.insertAdjacentHTML('beforeend', '<th></th>'); hr2.insertAdjacentHTML('beforeend', '<th></th>');
                tableHead.appendChild(hr); actualTableHead.appendChild(hr2);
            }

            function calculateSummary() { const totals=new Array(state.periods.length).fill(0); tableBody.querySelectorAll('tr').forEach(r=>{const rate=Number(r.dataset.rate||0); r.querySelectorAll('.hour-input').forEach((i,idx)=>totals[idx]+=rate*(Number(i.value)||0));}); summaryRow.querySelectorAll('.summary-cell').forEach((c,i)=>c.textContent=String(Math.round(totals[i]))); return totals; }
            function removeEmployeeRow(employeeId) { const row = Array.from(tableBody.querySelectorAll('tr')).find(r => String(r.querySelector('.employee-select')?.value||'')===String(employeeId)); if (row) row.remove(); calculateSummary(); syncActualTable(); }

            function syncActualTable() {
                actualTableBody.innerHTML=''; const totals=new Array(state.periods.length).fill(0); const currIdx=currentPeriodIndex();
                const plannedRows = Array.from(tableBody.querySelectorAll('tr')).map((r)=>({employeeId:String(r.querySelector('.employee-select').value), plannedHours:Array.from(r.querySelectorAll('.hour-input')).map(i=>Math.round(Number(i.value)||0))}));
                plannedRows.forEach((row) => {
                    const employee=getEmployeeMeta(row.employeeId); const tr=document.createElement('tr'); tr.innerHTML=`<td>${employee.name}</td><td>${employee.rate}</td>`;
                    for (let i=0;i<state.periods.length;i++) {
                        let hours = Number(state.actualMatrix[row.employeeId]?.[i] || 0);
                        const editable = currIdx >=0 && i >= currIdx;
                        if (editable) {
                            const edited = state.actualEdits[row.employeeId]?.[i];
                            hours = edited !== undefined ? Number(edited) : Number(row.plannedHours[i] || 0);
                            if (i === currIdx && state.approvedResourceHours[row.employeeId] !== undefined) {
                                hours = Number(state.approvedResourceHours[row.employeeId] || 0);
                            }
                        }
                        totals[i] += Math.round(hours) * employee.rate;
                        const style = `min-width:9rem;${i===currIdx?'background:#fff8c5;':''}`;
                        if (editable) {
                            const locked = (i===currIdx && state.approvedResourceLocked) ? 'disabled' : '';
                            tr.insertAdjacentHTML('beforeend', `<td style="${style}"><input type="number" min="0" step="0.1" class="form-control actual-input" data-employee-id="${row.employeeId}" data-index="${i}" value="${Math.round(hours)}" ${locked}></td>`);
                        } else {
                            tr.insertAdjacentHTML('beforeend', `<td style="${style}">${Math.round(hours)}</td>`);
                        }
                    }
                    tr.insertAdjacentHTML('beforeend', `<td><button type="button" class="btn btn-sm btn-danger actual-row-remove" data-employee-id="${row.employeeId}">✖</button></td>`);
                    actualTableBody.appendChild(tr);
                });
                actualSummaryRow.querySelectorAll('.actual-summary-cell').forEach((c,i)=>c.textContent=String(Math.round(totals[i])));
                state.actualTotals=totals;
                return totals;
            }

            function renderChart() {
                const chartSvg = document.getElementById('budgetChart');
                const budget = state.activeBudget || 0; const plannedTotals = calculateSummary(); const actualTotals = syncActualTable();
                const accum = (arr) => [budget, ...arr.reduce((a,v)=>{a.push((a[a.length-1]||budget)-v); return a;},[])];
                const pVals=accum(plannedTotals), aVals=accum(actualTotals); if (!state.periods.length) return;
                const w=1000,h=360,pd={left:60,right:20,top:20,bottom:40}, iw=w-pd.left-pd.right, ih=h-pd.top-pd.bottom;
                const max=Math.max(...pVals,...aVals,budget), min=Math.min(...pVals,...aVals,0), range=(max-min)||1;
                const pts=(vals)=>vals.map((v,i)=>({x:pd.left+i*iw/Math.max(vals.length-1,1), y:pd.top+((max-v)/range)*ih}));
                const pp=pts(pVals), ap=pts(aVals);
                chartSvg.setAttribute('viewBox', `0 0 ${w} ${h}`);
                chartSvg.innerHTML = `<polyline fill="none" stroke="#206bc4" stroke-width="2" points="${pp.map(p=>`${p.x},${p.y}`).join(' ')}"/><polyline fill="none" stroke="#000" stroke-width="2" points="${ap.map(p=>`${p.x},${p.y}`).join(' ')}"/>`;
            }

            async function loadSavedPlan(projectId){ const r=await fetch(getPlanUrl(planGetUrlTemplate,projectId)); if(!r.ok) return {status:'NEW',rows:[]}; return r.json(); }
            async function loadActualCosts(projectId){ const r=await fetch(getPlanUrl(actualCostsUrlTemplate,projectId)); if(!r.ok) return {matrix:{}}; return r.json(); }
            async function loadApprovedResourceForCurrent() {
                state.approvedResourceHours = {}; state.approvedResourceLocked = false;
                const idx = currentPeriodIndex(); if (!state.activeProject || idx < 0) return;
                const start = state.periods[idx].start;
                const r = await fetch(getApprovedResourceUrl(state.activeProject.id, start));
                if (!r.ok) return;
                const payload = await r.json();
                if (payload.approved) { state.approvedResourceHours = payload.hoursByEmployee || {}; state.approvedResourceLocked = true; }
            }

            async function applyProject(projectId){
                state.activeProject = projects.find((p)=>String(p.id)===String(projectId)) || null;
                if (!state.activeProject) return;
                state.activeBudget = Number(state.activeProject.budget||0);
                document.getElementById('projectStartDateLabel').textContent = state.activeProject.start || '—';
                document.getElementById('projectEndDateLabel').textContent = state.activeProject.end || '—';
                document.getElementById('projectBudgetLabel').textContent = String(Math.round(state.activeBudget));
                const [saved, actual] = await Promise.all([loadSavedPlan(projectId), loadActualCosts(projectId)]);
                state.periods = buildPeriods(); state.status = STATUS[saved.status] ? saved.status : 'NEW'; state.actualMatrix = actual.matrix || {}; state.actualEdits = {};
                renderHeaders(); tableBody.innerHTML='';
                (saved.rows?.length ? saved.rows : [{}, {}, {}]).forEach((row,i)=>createRow(row.employeeId ?? employees[i]?.id ?? null, Array.isArray(row.hours)?row.hours:[]));
                await loadApprovedResourceForCurrent();
                calculateSummary(); syncActualTable(); renderChart();
                document.getElementById('planStatusLabel').textContent = STATUS[state.status].label;
                document.getElementById('planStatusLabel').style.color = STATUS[state.status].color;
            }

            async function savePlan(status){
                if (!state.activeProject) return;
                const rows = Array.from(tableBody.querySelectorAll('tr')).map((row)=>({employeeId:row.querySelector('.employee-select')?.value, hours:Array.from(row.querySelectorAll('.hour-input')).map(i=>i.value)}));
                const resp = await fetch(getPlanUrl(planStatusUrlTemplate, state.activeProject.id), {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({status,rows})});
                if (!resp.ok) return;
                state.status = status;
                document.getElementById('planStatusLabel').textContent = STATUS[state.status].label;
                document.getElementById('planStatusLabel').style.color = STATUS[state.status].color;
            }

            function renderResourceTable() {
                const head = document.getElementById('resourceTableHead'); const body = document.getElementById('resourceTableBody');
                head.innerHTML = `<tr><th>Проект</th>${employees.map(e=>`<th>${toShortName(e.name)}</th>`).join('')}</tr>`;
                body.innerHTML = '';
                projects.forEach((p) => {
                    const row = resourceState.rows.find(r => String(r.projectId) === String(p.id)) || {projectId:p.id, hours:{}};
                    const disabled = RESOURCE_STATUS[resourceState.status].locked ? 'disabled' : '';
                    body.insertAdjacentHTML('beforeend', `<tr data-project-id="${p.id}"><td>${p.name}</td>${employees.map(e=>`<td><input type="number" min="0" step="0.1" class="form-control resource-input" data-project-id="${p.id}" data-employee-id="${e.id}" value="${row.hours?.[e.id] ?? 0}" ${disabled}></td>`).join('')}</tr>`);
                });
                document.getElementById('resourceStatusLabel').textContent = RESOURCE_STATUS[resourceState.status].label;
            }
            function collectResourceRows() {
                return projects.map((p)=>{
                    const hours = {};
                    employees.forEach((e)=>{ const input = document.querySelector(`.resource-input[data-project-id="${p.id}"][data-employee-id="${e.id}"]`); hours[String(e.id)] = Number(input?.value || 0); });
                    return {projectId:p.id, hours};
                });
            }
            async function loadResourcePlan(intervalStart) {
                const r = await fetch(getResourceUrl(resourceGetUrlTemplate, intervalStart));
                if (!r.ok) { resourceState.status = 'NEW'; resourceState.rows = []; renderResourceTable(); return; }
                const payload = await r.json(); resourceState.intervalStart = intervalStart; resourceState.status = RESOURCE_STATUS[payload.status] ? payload.status : 'NEW'; resourceState.rows = Array.isArray(payload.rows) ? payload.rows : []; renderResourceTable();
            }
            async function saveResourcePlan(status) {
                if (!resourceState.intervalStart) return;
                const rows = collectResourceRows();
                const r = await fetch(getResourceUrl(resourceStatusUrlTemplate, resourceState.intervalStart), {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({status, rows})});
                if (!r.ok) return;
                resourceState.status = status; resourceState.rows = rows; renderResourceTable();
                if (status === 'APPROVED') { await loadApprovedResourceForCurrent(); syncActualTable(); }
            }

            document.getElementById('projectSelect').addEventListener('change', (e)=>applyProject(e.target.value));
            document.getElementById('addRowButton').addEventListener('click', ()=>{createRow(); calculateSummary(); syncActualTable();});
            document.getElementById('buildChartButton').addEventListener('click', renderChart);
            document.getElementById('sendForApprovalButton').addEventListener('click', ()=>savePlan('SENT'));
            document.getElementById('approvePlanButton').addEventListener('click', ()=>{ if(isAdmin) savePlan('APPROVED'); });
            document.getElementById('rejectPlanButton').addEventListener('click', ()=>{ if(isAdmin) savePlan('REJECTED'); });
            tableBody.addEventListener('change', (e)=>{ if(e.target.classList.contains('employee-select')) updateRowRate(e.target.closest('tr')); calculateSummary(); syncActualTable(); });
            tableBody.addEventListener('input', (e)=>{ if(e.target.classList.contains('hour-input')) {calculateSummary(); syncActualTable();} });
            tableBody.addEventListener('click', (e)=>{ if (e.target.classList.contains('row-remove-button')) { e.target.closest('tr').remove(); calculateSummary(); syncActualTable(); } });
            actualTableBody.addEventListener('input', (e)=>{ if (e.target.classList.contains('actual-input')) { const id=e.target.dataset.employeeId, idx=Number(e.target.dataset.index); state.actualEdits[id] = state.actualEdits[id] || {}; state.actualEdits[id][idx] = Number(e.target.value||0); syncActualTable(); } });
            actualTableBody.addEventListener('click', (e)=>{ if (e.target.classList.contains('actual-row-remove')) removeEmployeeRow(e.target.dataset.employeeId); });

            const intervalSelect = document.getElementById('resourceIntervalSelect');
            intervalSelect.innerHTML = resourceIntervals.map((i)=>`<option value="${i.start}">${i.label}</option>`).join('');
            intervalSelect.addEventListener('change', (e)=>loadResourcePlan(e.target.value));
            document.getElementById('resourceDiscussButton').addEventListener('click', ()=>saveResourcePlan('IN_DISCUSSION'));
            document.getElementById('resourceRejectButton').addEventListener('click', ()=>saveResourcePlan('REJECTED'));
            document.getElementById('resourceApproveButton').addEventListener('click', ()=>saveResourcePlan('APPROVED'));

            if (document.getElementById('projectSelect').value) applyProject(document.getElementById('projectSelect').value);
            if (resourceIntervals.length > 0) loadResourcePlan(resourceIntervals[0].start);
        })();
    </script>
{% endblock %}
