{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Budget Plan-Actual Analysis</h3>
        </div>
        <div class="card-body">
            <div class="mb-4">
                <h4 class="fs-4 fw-bold mb-2">Активные проекты и статус базового плана</h4>
                <div class="table-responsive" style="max-height: 27rem; overflow-y: auto;">
                    <table class="table table-sm table-bordered mb-0">
                        <thead>
                            <tr>
                                <th>Проект</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody id="activeStatusTableBody">
                            {% for item in active_project_statuses %}
                                {% set color = item.status == 'APPROVED' ? '#198754' : (item.status == 'SENT' ? '#6c757d' : (item.status == 'REJECTED' ? '#ffc107' : '#000000')) %}
                                {% set label = item.status == 'APPROVED' ? 'Согласовано' : (item.status == 'SENT' ? 'Отправлено' : (item.status == 'REJECTED' ? 'Отклонено' : 'Новый')) %}
                                <tr data-project-id="{{ item.id }}">
                                    <td>{{ item.name }}</td>
                                    <td style="color: {{ color }};">{{ label }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="2">Нет активных проектов</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="projectSelect">Проект</label>
                    <select id="projectSelect" class="form-select">
                        {% for project in projects %}
                            <option value="{{ project.id }}">{{ project.name }}</option>
                        {% else %}
                            <option value="">Нет доступных проектов</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-2">
                    <label class="form-label">Дата начала проекта</label>
                    <div id="projectStartDateLabel" class="form-control-plaintext border rounded px-2 py-2 bg-light">—</div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Дата окончания проекта</label>
                    <div id="projectEndDateLabel" class="form-control-plaintext border rounded px-2 py-2 bg-light">—</div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Бюджет проекта</label>
                    <div id="projectBudgetLabel" class="form-control-plaintext border rounded px-2 py-2 bg-light">0</div>
                </div>
            </div>

            <div class="border-top border-bottom py-2 mb-3">
                <h4 class="display-6 fw-bold mb-2">Базовый план</h4>
            <div class="d-flex align-items-center gap-2 mb-2">
                <strong>Статус базового плана:</strong>
                <span id="planStatusLabel" class="fw-bold">Новый</span>
            </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <button id="sendForApprovalButton" type="button" class="btn btn-secondary">Отправить на согласование</button>
                <button id="approvePlanButton" type="button" class="btn btn-success" {% if not is_admin %}disabled{% endif %}>Согласовать</button>
                <button id="rejectPlanButton" type="button" class="btn btn-warning" {% if not is_admin %}disabled{% endif %}>Отклонено</button>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle" id="budgetTable" style="table-layout: fixed; width: 100%;">
                    <thead id="budgetTableHead"></thead>
                    <tbody id="budgetTableBody"></tbody>
                    <tfoot><tr id="summaryRow"><th colspan="3">Сумма (ставка × часы)</th></tr></tfoot>
                </table>
            </div>

            <div class="d-flex align-items-center gap-2 mt-3 flex-wrap">
                <button id="addRowButton" type="button" class="btn btn-outline-primary">+ БП</button>
                <button id="addWorkingRowButton" type="button" class="btn btn-outline-primary">+ РП</button>
                <button id="saveWorkingPlanButton" type="button" class="btn btn-success">Сохранить РП</button>
                <button id="rebuildWorkingPlanChartButton" type="button" class="btn btn-secondary">Перестроить график</button>
                <button id="loadSavedWorkingPlanButton" type="button" class="btn btn-outline-dark">Последний сохраненный РП</button>
                <button id="sendToResourcePlanButton" type="button" class="btn btn-primary">Отправить на ресурсный план</button>
            </div>

            <div class="table-responsive mt-3">
                <table class="table table-bordered align-middle" id="actualTable" style="table-layout: fixed; width: 100%;">
                    <thead id="actualTableHead"></thead>
                    <tbody id="actualTableBody"></tbody>
                    <tfoot><tr id="actualSummaryRow"><th colspan="2">Факт (таймшиты, часы × ставка)</th></tr></tfoot>
                </table>
            </div>

            <div class="mt-4">
                <h4 class="display-6 fw-bold mb-2">Сравнение базового плана и фактического расхода бюджета</h4>
                <div class="small mb-2">
                    <span style="color:#206bc4;">● Синяя линия — базовый план</span>
                    <span class="ms-3" style="color:#000000;">● Черная линия — рабочий план</span>
                </div>
                <div class="border rounded p-2" style="max-width: 1000px;">
                    <svg id="budgetChart" width="100%" height="360" viewBox="0 0 1000 360" preserveAspectRatio="xMinYMin meet" role="img" aria-label="График расходования бюджета"></svg>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const projects = {{ project_data|json_encode|raw }};
            const employees = {{ employees|json_encode|raw }};
            const isAdmin = {{ is_admin ? 'true' : 'false' }};
            const planGetUrlTemplate = '{{ path('demo_budget_plan_get', {'project': 'PROJECT_ID'}) }}';
            const planStatusUrlTemplate = '{{ path('demo_budget_plan_status', {'project': 'PROJECT_ID'}) }}';
            const actualCostsUrlTemplate = '{{ path('demo_budget_plan_actual_costs', {'project': 'PROJECT_ID'}) }}';
            const resourcePlanGetUrlTemplate = '{{ path('demo_resource_plan_get', {'intervalId': 'INTERVAL_ID'}) }}';
            const resourcePlanBulkUrl = '{{ path('demo_resource_plan_bulk') }}';
            const resourcePlanStatusUrlTemplate = '{{ path('demo_resource_plan_status', {'intervalId': 'INTERVAL_ID'}) }}';
            const workingPlanGetUrlTemplate = '{{ path('demo_working_plan_get', {'project': 'PROJECT_ID'}) }}';
            const workingPlanSaveUrlTemplate = '{{ path('demo_working_plan_save', {'project': 'PROJECT_ID'}) }}';

            const STATUS = {
                NEW: {label: 'Новый', color: '#000000', locked: false},
                SENT: {label: 'Отправлено', color: '#6c757d', locked: true},
                APPROVED: {label: 'Согласовано', color: '#198754', locked: true},
                REJECTED: {label: 'Отклонено', color: '#ffc107', locked: false}
            };

            const state = {weeks: [], activeProject: null, activeBudget: 0, status: 'NEW', actualWeeks: [], actualMatrix: {}, actualTotals: [], resourcePlanTotals: [], actualOverrides: {}, currentResourcePlan: {intervalId: null, status: 'NEW', cells: {}}, resourcePlansByInterval: {}, workingPlanRows: [], savedWorkingPlanRows: null, hasSavedWorkingPlan: false};
            const employeeMap = new Map(employees.map((employee) => [String(employee.id), employee]));

            const projectSelect = document.getElementById('projectSelect');
            const projectStartDateLabel = document.getElementById('projectStartDateLabel');
            const projectEndDateLabel = document.getElementById('projectEndDateLabel');
            const projectBudgetLabel = document.getElementById('projectBudgetLabel');
            const planStatusLabel = document.getElementById('planStatusLabel');
            const tableHead = document.getElementById('budgetTableHead');
            const tableBody = document.getElementById('budgetTableBody');
            const summaryRow = document.getElementById('summaryRow');
            const chartSvg = document.getElementById('budgetChart');
            const addRowButton = document.getElementById('addRowButton');
            const addWorkingRowButton = document.getElementById('addWorkingRowButton');
            const saveWorkingPlanButton = document.getElementById('saveWorkingPlanButton');
            const rebuildWorkingPlanChartButton = document.getElementById('rebuildWorkingPlanChartButton');
            const loadSavedWorkingPlanButton = document.getElementById('loadSavedWorkingPlanButton');
            const sendToResourcePlanButton = document.getElementById('sendToResourcePlanButton');
            const activeStatusTableBody = document.getElementById('activeStatusTableBody');
            const actualTableHead = document.getElementById('actualTableHead');
            const actualTableBody = document.getElementById('actualTableBody');
            const actualSummaryRow = document.getElementById('actualSummaryRow');

            function createSectionTitle(text) {
                const wrapper = document.createElement('div');
                wrapper.className = 'border-top border-bottom py-2 mb-3';
                const title = document.createElement('h4');
                title.className = 'display-6 fw-bold mb-0';
                title.textContent = text;
                wrapper.appendChild(title);

                return wrapper;
            }

            function setupManagementLayout() {
                addRowButton.textContent = '+ Сотрудник';
                addWorkingRowButton.textContent = '+ Сотрудник';

                const statusRow = planStatusLabel.parentElement;
                const statusContainer = statusRow?.parentElement;
                if (statusRow && statusContainer && !statusContainer.classList.contains('border-top')) {
                    const section = document.createElement('div');
                    section.className = 'border-top border-bottom py-2 mb-3';
                    const title = document.createElement('h4');
                    title.className = 'display-6 fw-bold mb-2';
                    title.textContent = 'Базовый план';
                    section.appendChild(title);
                    section.appendChild(statusRow);
                    statusContainer.parentElement?.insertBefore(section, statusContainer);
                    statusContainer.remove();
                }

                const approvalRow = document.getElementById('sendForApprovalButton')?.parentElement;
                if (approvalRow && addRowButton.parentElement !== approvalRow) {
                    approvalRow.appendChild(addRowButton);
                }

                const workingButtonRow = saveWorkingPlanButton.parentElement;
                if (workingButtonRow) {
                    workingButtonRow.className = 'd-flex flex-wrap gap-2 mb-3';

                    [saveWorkingPlanButton, rebuildWorkingPlanChartButton, loadSavedWorkingPlanButton, sendToResourcePlanButton].forEach((button) => {
                        button.className = 'btn btn-outline-dark working-plan-action';
                        button.style.width = '15rem';
                    });

                    const workingTitle = createSectionTitle('Рабочий план');
                    workingButtonRow.parentElement?.insertBefore(workingTitle, workingButtonRow);

                    const addWorkingRow = document.createElement('div');
                    addWorkingRow.className = 'd-flex flex-wrap gap-2 mb-3';
                    addWorkingRow.appendChild(addWorkingRowButton);
                    workingButtonRow.insertAdjacentElement('afterend', addWorkingRow);
                }

                const comparisonSection = chartSvg.closest('.mt-4');
                if (comparisonSection) {
                    comparisonSection.classList.add('pt-2');
                    const title = comparisonSection.querySelector('h4');
                    if (title) {
                        title.className = 'display-6 fw-bold mb-2';
                        title.textContent = 'Сравнение базового плана и фактического расхода бюджета';
                    }

                    const legend = comparisonSection.querySelector('.small');
                    if (legend && !legend.querySelector('[data-chart-legend="green"]')) {
                        const greenLegend = document.createElement('span');
                        greenLegend.className = 'ms-3';
                        greenLegend.dataset.chartLegend = 'green';
                        greenLegend.style.color = '#2fb344';
                        greenLegend.textContent = '● Зеленая линия — ресурсный план';
                        legend.appendChild(greenLegend);
                    }
                }
            }

            setupManagementLayout();

            const resourcePlanSummaryRow = (() => {
                const row = document.createElement('tr');
                row.id = 'resourcePlanSummaryRow';
                row.innerHTML = '<th colspan="2">Ресурсный план</th>';
                actualSummaryRow.parentElement?.appendChild(row);

                return row;
            })();

            actualSummaryRow.querySelector('th')?.setAttribute('colspan', '3');
            if (actualSummaryRow.querySelector('th')) {
                actualSummaryRow.querySelector('th').textContent = 'Рабочий план (часы × ставка)';
            }
            resourcePlanSummaryRow.querySelector('th')?.setAttribute('colspan', '3');

            const COLUMN_WIDTH = {
                employee: '16rem',
                rate: '8rem',
                actions: '6rem',
                period: '9rem',
            };

            function applyCellWidth(cell, width) {
                cell.style.width = width;
                cell.style.minWidth = width;
                cell.style.maxWidth = width;
            }

            function getReadonlyActualCellMarkup(value) {
                return `<span class="form-control actual-hour-label" style="width:100%; box-sizing:border-box; background-color:#e9ecef; pointer-events:none;">${value}</span>`;
            }

            function getPlanUrl(template, projectId) { return template.replace('PROJECT_ID', String(projectId)); }
            function getResourcePlanUrl(template, intervalId) { return template.replace('INTERVAL_ID', String(intervalId)); }
            function parseLocalDate(value) {
                if (typeof value !== 'string') {
                    return null;
                }

                const parts = value.split('-').map((part) => parseInt(part, 10));
                if (parts.length !== 3 || parts.some((part) => Number.isNaN(part))) {
                    return null;
                }

                return new Date(parts[0], parts[1] - 1, parts[2], 12, 0, 0, 0);
            }
            function getMonday(date) { const r = new Date(date); const d=r.getDay(); r.setDate(r.getDate() + (d===0?-6:1-d)); r.setHours(0,0,0,0); return r; }
            function getSunday(date) { const s = getMonday(date); s.setDate(s.getDate()+6); s.setHours(23,59,59,999); return s; }
            function formatDateKey(date) {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }
            function formatShortDate(date) {
                const day = String(date.getDate()).padStart(2, '0');
                const month = String(date.getMonth() + 1).padStart(2, '0');
                return `${day}.${month}`;
            }
            function getTwoWeekLabel(periodStart) {
                const periodEnd = new Date(periodStart);
                periodEnd.setDate(periodEnd.getDate() + 13);
                return `${formatShortDate(periodStart)}\n${formatShortDate(periodEnd)}`;
            }

            function buildAlignedBiweeklyIntervals(startDate, endDate) {
                if (!(startDate instanceof Date) || !(endDate instanceof Date)) {
                    return [];
                }

                const rangeStart = getMonday(startDate);
                rangeStart.setDate(rangeStart.getDate() - 14);
                const rangeEnd = getSunday(endDate);
                rangeEnd.setDate(rangeEnd.getDate() + 14);

                const januaryFirst = new Date(startDate.getFullYear(), 0, 1, 12, 0, 0, 0);
                const cursor = getMonday(januaryFirst);
                const intervals = [];

                while (cursor <= rangeEnd) {
                    const intervalStart = new Date(cursor);
                    const intervalEnd = new Date(cursor);
                    intervalEnd.setDate(intervalEnd.getDate() + 13);
                    intervalEnd.setHours(23, 59, 59, 999);

                    if (intervalEnd >= rangeStart) {
                        intervals.push({
                            start: formatDateKey(intervalStart),
                            resourcePlanId: intervalStart.toISOString().slice(0, 10),
                            label: getTwoWeekLabel(intervalStart),
                        });
                    }

                    cursor.setDate(cursor.getDate() + 14);
                }

                return intervals;
            }

            function buildWeeks() {
                if (!state.activeProject || !state.activeProject.start || !state.activeProject.end) return [];
                const startDate = parseLocalDate(state.activeProject.start); const endDate = parseLocalDate(state.activeProject.end);
                if (!(startDate instanceof Date) || !(endDate instanceof Date)) return [];
                if (Number.isNaN(startDate.getTime()) || Number.isNaN(endDate.getTime()) || startDate > endDate) return [];
                return buildAlignedBiweeklyIntervals(startDate, endDate);
            }

            function getCurrentBiweeklyIndex() {
                if (state.weeks.length === 0) {
                    return -1;
                }

                const now = new Date();
                now.setHours(12, 0, 0, 0);

                for (let i = 0; i < state.weeks.length; i++) {
                    const start = parseLocalDate(state.weeks[i].start);
                    if (!(start instanceof Date)) {
                        continue;
                    }
                    start.setHours(0, 0, 0, 0);
                    const end = new Date(start);
                    end.setDate(end.getDate() + 13);
                    end.setHours(23, 59, 59, 999);
                    if (now >= start && now <= end) {
                        return i;
                    }
                }

                const firstStart = parseLocalDate(state.weeks[0].start);
                if (!(firstStart instanceof Date)) {
                    return -1;
                }
                firstStart.setHours(0, 0, 0, 0);
                if (now < firstStart) {
                    return 0;
                }

                return state.weeks.length;
            }

            function refreshActualSummaryFromRenderedTable() {
                const totals = new Array(state.weeks.length).fill(0);
                actualTableBody.querySelectorAll('tr').forEach((row) => {
                    const rate = parseFloat(row.dataset.rate || '0') || 0;
                    row.querySelectorAll('.actual-hour-cell').forEach((cell, idx) => {
                        const input = cell.querySelector('.actual-hour-input');
                        const hours = input ? (parseFloat(input.value || '0') || 0) : (parseFloat(cell.dataset.hours || '0') || 0);
                        totals[idx] += hours * rate;
                    });
                });

                actualSummaryRow.querySelectorAll('.actual-summary-cell').forEach((cell, idx) => {
                    cell.textContent = String(Math.round(totals[idx]));
                });
                state.actualTotals = totals;
            }

            function getResourcePlanCostForInterval(interval, projectId) {
                const resourcePlan = state.resourcePlansByInterval[String(interval?.resourcePlanId || '')];
                if (!resourcePlan || resourcePlan.status !== 'APPROVED') {
                    return 0;
                }

                return employees.reduce((sum, employee) => {
                    const cellKey = `${resourcePlan.intervalId}::${projectId}::${employee.id}`;
                    const hours = parseFloat(resourcePlan.cells[cellKey] || '0') || 0;
                    const rate = Number(employee.hourlyRate || 0) || 0;

                    return sum + (hours * rate);
                }, 0);
            }

            function refreshResourcePlanSummary() {
                const projectId = String(state.activeProject?.id ?? '');
                const currentBiweeklyIndex = getCurrentBiweeklyIndex();
                const actualTotals = state.actualTotals.length === state.weeks.length
                    ? state.actualTotals
                    : new Array(state.weeks.length).fill(0);
                const totals = state.weeks.map((interval, idx) => {
                    if (currentBiweeklyIndex >= 0 && idx < currentBiweeklyIndex) {
                        return Math.round(getResourcePlanCostForInterval(interval, projectId));
                    }

                    return Math.round(actualTotals[idx] || 0);
                });

                resourcePlanSummaryRow.querySelectorAll('.resource-plan-summary-cell').forEach((cell, idx) => {
                    cell.textContent = String(totals[idx] || 0);
                });

                state.resourcePlanTotals = totals;
            }

            function setStatus(status) {
                state.status = STATUS[status] ? status : 'NEW';
                planStatusLabel.textContent = STATUS[state.status].label;
                planStatusLabel.style.color = STATUS[state.status].color;
                const locked = STATUS[state.status].locked;
                addRowButton.disabled = locked;
                tableBody.querySelectorAll('.hour-input, .employee-select, .remove-row-button').forEach((el) => { el.disabled = locked; });
                if (state.activeProject) {
                    const row = activeStatusTableBody.querySelector(`tr[data-project-id="${state.activeProject.id}"] td:last-child`);
                    if (row) { row.textContent = STATUS[state.status].label; row.style.color = STATUS[state.status].color; }
                }
            }

            function createEmployeeOptions() {
                if (employees.length === 0) return '<option value="">Нет сотрудников</option>';
                return employees.map((e) => `<option value="${e.id}">${e.name}</option>`).join('');
            }

            function getEmployeeMeta(employeeId) {
                const mapped = employeeMap.get(String(employeeId));
                if (mapped) {
                    return {
                        id: String(employeeId),
                        name: mapped.name,
                        rate: Math.round(Number(mapped.hourlyRate || 0)),
                    };
                }

                return {
                    id: String(employeeId),
                    name: `Пользователь_${employeeId}`,
                    rate: 0,
                };
            }

            function updateRowRate(row) {
                const select = row.querySelector('.employee-select');
                const rateLabel = row.querySelector('.rate-label');
                const employee = employeeMap.get(String(select.value));
                const rate = employee ? Number(employee.hourlyRate || 0) : 0;
                rateLabel.textContent = String(Math.round(rate));
                row.dataset.rate = String(rate);
            }

            function createRow(initialEmployeeId = null, hourValues = []) {
                const tr = document.createElement('tr'); tr.dataset.rate = '0';
                const employeeCell = document.createElement('td'); employeeCell.innerHTML = `<select class="form-select employee-select">${createEmployeeOptions()}</select>`; applyCellWidth(employeeCell, COLUMN_WIDTH.employee);
                const rateCell = document.createElement('td'); rateCell.innerHTML = '<span class="rate-label">0</span>'; applyCellWidth(rateCell, COLUMN_WIDTH.rate);
                const actionsCell = document.createElement('td');
                actionsCell.innerHTML = '<button type="button" class="btn btn-sm btn-danger remove-row-button" title="Удалить строку">✕</button>';
                applyCellWidth(actionsCell, COLUMN_WIDTH.actions);
                tr.appendChild(employeeCell); tr.appendChild(rateCell); tr.appendChild(actionsCell);
                for (let i=0;i<state.weeks.length;i++) {
                    const hourCell = document.createElement('td');
                    applyCellWidth(hourCell, COLUMN_WIDTH.period);
                    hourCell.innerHTML = `<input type="number" min="0" step="0.1" class="form-control hour-input" style="width:100%; box-sizing:border-box;" value="${hourValues[i] ?? '0'}">`;
                    tr.appendChild(hourCell);
                }
                tableBody.appendChild(tr);
                const select = tr.querySelector('.employee-select');
                if (initialEmployeeId !== null) select.value = String(initialEmployeeId);
                if (!select.value && employees.length > 0) select.value = String(employees[0].id);
                updateRowRate(tr);
            }

            function getCurrentRowsPayload() {
                return Array.from(tableBody.querySelectorAll('tr')).map((row) => ({
                    employeeId: row.querySelector('.employee-select')?.value ?? null,
                    hours: Array.from(row.querySelectorAll('.hour-input')).map((input) => input.value),
                }));
            }

            function getCurrentWorkingRowsPayload() {
                return Array.from(actualTableBody.querySelectorAll('tr')).map((row) => ({
                    employeeId: row.querySelector('.working-employee-select')?.value ?? null,
                    hours: Array.from(row.querySelectorAll('.actual-hour-cell')).map((cell) => {
                        const input = cell.querySelector('.actual-hour-input');
                        return String(input ? (parseFloat(input.value || '0') || 0) : (parseFloat(cell.dataset.hours || '0') || 0));
                    }),
                }));
            }

            function isCurrentResourcePlanApproved() {
                const currentBiweeklyIndex = getCurrentBiweeklyIndex();
                if (currentBiweeklyIndex < 0 || currentBiweeklyIndex >= state.weeks.length) {
                    return false;
                }

                const intervalId = state.weeks[currentBiweeklyIndex]?.resourcePlanId ?? '';
                return state.resourcePlansByInterval[String(intervalId)]?.status === 'APPROVED';
            }

            function isWorkingPlanCellEditable(intervalIndex) {
                const currentBiweeklyIndex = getCurrentBiweeklyIndex();
                if (currentBiweeklyIndex < 0) {
                    return true;
                }

                if (currentBiweeklyIndex >= state.weeks.length) {
                    return false;
                }

                if (intervalIndex < currentBiweeklyIndex) {
                    return false;
                }

                if (intervalIndex === currentBiweeklyIndex && isCurrentResourcePlanApproved()) {
                    return false;
                }

                return true;
            }

            function updateWorkingRowRate(row) {
                const select = row.querySelector('.working-employee-select');
                const rateLabel = row.querySelector('.working-rate-label');
                const employee = employeeMap.get(String(select?.value || ''));
                const rate = employee ? Number(employee.hourlyRate || 0) : 0;
                if (rateLabel) {
                    rateLabel.textContent = String(Math.round(rate));
                }
                row.dataset.rate = String(rate);
            }

            function createWorkingRow(initialEmployeeId = null, hourValues = []) {
                const tr = document.createElement('tr');
                tr.dataset.rate = '0';

                const employeeCell = document.createElement('td');
                employeeCell.innerHTML = `<select class="form-select working-employee-select">${createEmployeeOptions()}</select>`;
                applyCellWidth(employeeCell, COLUMN_WIDTH.employee);
                tr.appendChild(employeeCell);

                const rateCell = document.createElement('td');
                rateCell.innerHTML = '<span class="working-rate-label">0</span>';
                applyCellWidth(rateCell, COLUMN_WIDTH.rate);
                tr.appendChild(rateCell);

                const actionsCell = document.createElement('td');
                actionsCell.innerHTML = '<button type="button" class="btn btn-sm btn-danger remove-working-row-button" title="Удалить строку">×</button>';
                applyCellWidth(actionsCell, COLUMN_WIDTH.actions);
                tr.appendChild(actionsCell);

                for (let i = 0; i < state.weeks.length; i++) {
                    const hourCell = document.createElement('td');
                    hourCell.className = 'actual-hour-cell';
                    applyCellWidth(hourCell, COLUMN_WIDTH.period);
                    const value = parseFloat(hourValues[i] || '0') || 0;
                    const editable = isWorkingPlanCellEditable(i);
                    hourCell.dataset.hours = String(value);
                    if (editable) {
                        hourCell.innerHTML = `<input type="number" min="0" step="0.1" class="form-control actual-hour-input" style="width:100%; box-sizing:border-box;" data-biweekly-index="${i}" value="${value}">`;
                    } else {
                        hourCell.innerHTML = getReadonlyActualCellMarkup(value);
                    }
                    tr.appendChild(hourCell);
                }

                actualTableBody.appendChild(tr);
                const select = tr.querySelector('.working-employee-select');
                if (initialEmployeeId !== null && select) {
                    select.value = String(initialEmployeeId);
                }
                if (select && !select.value && employees.length > 0) {
                    select.value = String(employees[0].id);
                }
                updateWorkingRowRate(tr);
            }

            function renderWorkingPlanTable(rows = []) {
                actualTableBody.innerHTML = '';
                state.workingPlanRows = Array.isArray(rows) ? rows.map((row) => ({
                    employeeId: row.employeeId ?? null,
                    hours: Array.isArray(row.hours) ? row.hours : [],
                })) : [];

                state.workingPlanRows.forEach((row) => createWorkingRow(row.employeeId ?? null, row.hours ?? []));

                if (state.workingPlanRows.length === 0) {
                    createWorkingRow();
                }

                actualTableHead.querySelectorAll('th').forEach((cell, idx) => {
                    const biweeklyIndex = idx - 3;
                    cell.style.backgroundColor = biweeklyIndex === getCurrentBiweeklyIndex() ? '#fff3cd' : '';
                });

                actualSummaryRow.querySelectorAll('.actual-summary-cell').forEach((cell, idx) => {
                    cell.style.backgroundColor = idx === getCurrentBiweeklyIndex() ? '#fff3cd' : '';
                });

                resourcePlanSummaryRow.querySelectorAll('.resource-plan-summary-cell').forEach((cell, idx) => {
                    cell.style.backgroundColor = idx === getCurrentBiweeklyIndex() ? '#fff3cd' : '';
                });

                refreshActualSummaryFromRenderedTable();
                refreshResourcePlanSummary();
            }

            function renderHeaders() {
                tableHead.innerHTML = ''; summaryRow.querySelectorAll('td').forEach((c) => c.remove());
                actualTableHead.innerHTML = '';
                actualSummaryRow.querySelectorAll('td').forEach((c) => c.remove());
                resourcePlanSummaryRow.querySelectorAll('td').forEach((c) => c.remove());
                const hr = document.createElement('tr'); hr.innerHTML = '<th>ФИО сотрудника</th><th>Часовая ставка</th><th>Действия</th>';
                applyCellWidth(hr.children[0], COLUMN_WIDTH.employee);
                applyCellWidth(hr.children[1], COLUMN_WIDTH.rate);
                applyCellWidth(hr.children[2], COLUMN_WIDTH.actions);
                const hr2 = document.createElement('tr'); hr2.innerHTML = '<th>ФИО сотрудника</th><th>Часовая ставка</th>';
                applyCellWidth(hr2.children[0], COLUMN_WIDTH.employee);
                applyCellWidth(hr2.children[1], COLUMN_WIDTH.rate);
                const actualActionsHeader = document.createElement('th');
                actualActionsHeader.textContent = 'Действия';
                applyCellWidth(actualActionsHeader, COLUMN_WIDTH.actions);
                hr2.appendChild(actualActionsHeader);
                state.weeks.forEach((week) => {
                    const th = document.createElement('th'); th.textContent = week.label; th.style.whiteSpace = 'pre-line'; applyCellWidth(th, COLUMN_WIDTH.period); hr.appendChild(th);
                    const s = document.createElement('td'); s.className = 'summary-cell'; applyCellWidth(s, COLUMN_WIDTH.period); s.textContent = '0'; summaryRow.appendChild(s);
                    const th2 = document.createElement('th'); th2.textContent = week.label; th2.style.whiteSpace = 'pre-line'; applyCellWidth(th2, COLUMN_WIDTH.period); hr2.appendChild(th2);
                    const s2 = document.createElement('td'); s2.className = 'actual-summary-cell'; applyCellWidth(s2, COLUMN_WIDTH.period); s2.textContent = '0'; actualSummaryRow.appendChild(s2);
                    const s3 = document.createElement('td'); s3.className = 'resource-plan-summary-cell'; applyCellWidth(s3, COLUMN_WIDTH.period); s3.textContent = '0'; resourcePlanSummaryRow.appendChild(s3);
                });
                tableHead.appendChild(hr); actualTableHead.appendChild(hr2);
            }

            function renderTableStructure(rowsFromStorage = null) {
                state.weeks = buildWeeks();
                renderHeaders(); tableBody.innerHTML = '';
                const rows = Array.isArray(rowsFromStorage) ? rowsFromStorage : [];
                if (rows.length === 0) {
                    const assignedEmployeeIds = Array.isArray(state.activeProject?.assignedEmployeeIds) && state.activeProject.assignedEmployeeIds.length > 0
                        ? state.activeProject.assignedEmployeeIds
                        : employees.slice(0, 3).map((employee) => employee.id);
                    assignedEmployeeIds.forEach((employeeId) => createRow(employeeId));
                } else {
                    rows.forEach((row) => createRow(row.employeeId ?? null, Array.isArray(row.hours) ? row.hours : []));
                }
                setStatus(state.status);
                calculateSummary();
            }

            function calculateSummary() {
                const totals = new Array(state.weeks.length).fill(0);
                tableBody.querySelectorAll('tr').forEach((row) => {
                    const rate = parseFloat(row.dataset.rate || '0') || 0;
                    row.querySelectorAll('.hour-input').forEach((input, idx) => { totals[idx] += rate * (parseFloat(input.value||'0')||0); });
                });
                summaryRow.querySelectorAll('.summary-cell').forEach((cell, idx) => { cell.textContent = String(Math.round(totals[idx])); });
                return totals;
            }

            function syncActualTable() {
                renderWorkingPlanTable(getCurrentWorkingRowsPayload());
                return state.actualTotals;
            }

            function renderChart() {
                const budget = state.activeBudget || 0;
                const plannedTotals = calculateSummary();
                const actualTotals = state.actualTotals.length === state.weeks.length ? state.actualTotals : syncActualTable();
                if (state.resourcePlanTotals.length !== state.weeks.length) {
                    refreshResourcePlanSummary();
                }
                const resourcePlanTotals = state.resourcePlanTotals.length === state.weeks.length ? state.resourcePlanTotals : new Array(state.weeks.length).fill(0);

                if (plannedTotals.some((v) => v > budget)) {
                    alert('Внимание! Экономика проекта отрицательная');
                }

                const buildSeries = (totals) => {
                    const values = [budget];
                    totals.forEach((weekTotal) => {
                        values.push(values[values.length - 1] - weekTotal);
                    });
                    return values;
                };

                const buildResourcePlanChartSeries = (blackValues, totals, currentBiweeklyIndex) => {
                    const values = [budget];
                    for (let i = 0; i < totals.length; i++) {
                        if (currentBiweeklyIndex >= 0 && i >= currentBiweeklyIndex) {
                            values.push(null);
                            continue;
                        }

                        values.push((blackValues[i] ?? budget) - (totals[i] ?? 0));
                    }

                    return values;
                };

                const plannedValues = buildSeries(plannedTotals);
                const actualValues = buildSeries(actualTotals);
                const currentBiweeklyIndex = getCurrentBiweeklyIndex();
                const resourcePlanValues = buildResourcePlanChartSeries(actualValues, resourcePlanTotals, currentBiweeklyIndex);

                if (state.weeks.length === 0) {
                    chartSvg.innerHTML = '<text x="20" y="40">У выбранного проекта нет корректных дат.</text>';
                    return;
                }

                const p = {left: 80, right: 30, top: 20, bottom: 55};
                const w = 1000;
                const h = 360;
                const iw = w - p.left - p.right;
                const ih = h - p.top - p.bottom;

                const definedResourcePlanValues = resourcePlanValues.filter((value) => value !== null);
                const allValues = [...plannedValues, ...actualValues, ...definedResourcePlanValues, 0, budget];
                let min = Math.min(...allValues);
                let max = Math.max(...allValues);
                const pad = Math.max((max - min) * 0.1, 1);
                min -= pad;
                max += pad;
                const range = max - min || 1;

                const toPoints = (values) => values.map((value, index) => {
                    if (value === null) {
                        return {
                            x: p.left + (index * iw) / Math.max(values.length - 1, 1),
                            y: null,
                            value: null,
                        };
                    }

                    return {
                        x: p.left + (index * iw) / Math.max(values.length - 1, 1),
                        y: p.top + ((max - value) / range) * ih,
                        value,
                    };
                });

                const plannedPts = toPoints(plannedValues);
                const actualPts = toPoints(actualValues);
                const resourcePlanPts = toPoints(resourcePlanValues);
                const y0 = p.top + ((max - 0) / range) * ih;

                const buildPlannedSegments = (pts) => {
                    let seg = '';
                    for (let i = 1; i < pts.length; i++) {
                        const a = pts[i - 1];
                        const b = pts[i];
                        if ((a.value >= 0 && b.value >= 0) || (a.value < 0 && b.value < 0)) {
                            const color = a.value < 0 && b.value < 0 ? '#dc3545' : '#206bc4';
                            seg += `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="${color}" stroke-width="2.5" />`;
                        } else {
                            const t = (0 - a.value) / (b.value - a.value);
                            const cx = a.x + (b.x - a.x) * t;
                            const cy = a.y + (b.y - a.y) * t;
                            seg += `<line x1="${a.x}" y1="${a.y}" x2="${cx}" y2="${cy}" stroke="${a.value < 0 ? '#dc3545' : '#206bc4'}" stroke-width="2.5" />`;
                            seg += `<line x1="${cx}" y1="${cy}" x2="${b.x}" y2="${b.y}" stroke="${b.value < 0 ? '#dc3545' : '#206bc4'}" stroke-width="2.5" />`;
                        }
                    }
                    return seg;
                };

                const buildPolyline = (pts, color) => {
                    const segments = [];
                    let currentSegment = [];

                    pts.forEach((pt) => {
                        if (pt.value === null || pt.y === null) {
                            if (currentSegment.length > 1) {
                                segments.push(currentSegment);
                            }
                            currentSegment = [];
                            return;
                        }

                        currentSegment.push(pt);
                    });

                    if (currentSegment.length > 1) {
                        segments.push(currentSegment);
                    }

                    return segments.map((segment) => `<polyline fill="none" stroke="${color}" stroke-width="2" points="${segment.map((pt) => `${pt.x},${pt.y}`).join(' ')}" />`).join('');
                };

                const xLabels = ['', ...state.weeks.map((week) => week.label)];
                const buildAxisLabel = (pt, label) => {
                    const lines = String(label || '').split('\n');
                    return `<text x="${pt.x}" y="${h - p.bottom + 18}" text-anchor="middle" font-size="11">${lines.map((line, index) => `<tspan x="${pt.x}" dy="${index === 0 ? 0 : 12}">${line}</tspan>`).join('')}</text>`;
                };

                chartSvg.setAttribute('viewBox', `0 0 ${w} ${h}`);
                chartSvg.innerHTML = `
                    <line x1="${p.left}" y1="${p.top}" x2="${p.left}" y2="${h - p.bottom}" stroke="#333" />
                    <line x1="${p.left}" y1="${h - p.bottom}" x2="${w - p.right}" y2="${h - p.bottom}" stroke="#333" />
                    <line x1="${p.left}" y1="${y0}" x2="${w - p.right}" y2="${y0}" stroke="#666" stroke-dasharray="4 3" />
                    ${buildPolyline(actualPts, '#000000')}
                    ${buildPolyline(resourcePlanPts, '#2fb344')}
                    ${buildPlannedSegments(plannedPts)}
                    ${actualPts.map((pt) => `<circle cx="${pt.x}" cy="${pt.y}" r="3" fill="#000000" />`).join('')}
                    ${resourcePlanPts.filter((pt) => pt.value !== null && pt.y !== null).map((pt) => `<circle cx="${pt.x}" cy="${pt.y}" r="3" fill="#2fb344" />`).join('')}
                    ${plannedPts.map((pt) => `<circle cx="${pt.x}" cy="${pt.y}" r="3" fill="${pt.value < 0 ? '#dc3545' : '#206bc4'}" />`).join('')}
                    ${plannedPts.map((pt, idx) => buildAxisLabel(pt, xLabels[idx] || '')).join('')}
                    ${plannedPts.map((pt) => `<text x="${pt.x}" y="${pt.y - 10}" text-anchor="middle" font-size="10" fill="#206bc4">${Math.round(pt.value)}</text>`).join('')}
                    ${actualPts.map((pt) => `<text x="${pt.x}" y="${pt.y + 14}" text-anchor="middle" font-size="10" fill="#000000">${Math.round(pt.value)}</text>`).join('')}
                    ${resourcePlanPts.filter((pt) => pt.value !== null && pt.y !== null).map((pt) => `<text x="${pt.x}" y="${pt.y - 24}" text-anchor="middle" font-size="10" fill="#2fb344">${Math.round(pt.value)}</text>`).join('')}
                `;
            }

            async function loadSavedPlan(projectId) {
                const r = await fetch(getPlanUrl(planGetUrlTemplate, projectId));
                if (!r.ok) return {status:'NEW', rows:[]};
                const payload = await r.json();
                return {status: STATUS[payload.status] ? payload.status : 'NEW', rows: Array.isArray(payload.rows) ? payload.rows : []};
            }

            async function loadActualCosts(projectId) {
                const r = await fetch(getPlanUrl(actualCostsUrlTemplate, projectId));
                if (!r.ok) return {weeks: [], matrix: {}};
                const payload = await r.json();
                return {
                    weeks: Array.isArray(payload.weeks) ? payload.weeks : [],
                    matrix: payload.matrix && typeof payload.matrix === 'object' ? payload.matrix : {},
                };
            }

            async function loadResourcePlan(intervalId) {
                if (!intervalId) {
                    return {intervalId: null, status: 'NEW', cells: {}};
                }

                const r = await fetch(getResourcePlanUrl(resourcePlanGetUrlTemplate, intervalId));
                if (!r.ok) {
                    return {intervalId, status: 'NEW', cells: {}};
                }

                const payload = await r.json();
                return {
                    intervalId,
                    status: ['DISCUSSION', 'APPROVED', 'CORRECTING'].includes(payload.status) ? payload.status : 'NEW',
                    cells: payload.cells && typeof payload.cells === 'object' ? payload.cells : {},
                };
            }

            async function loadResourcePlans(intervals) {
                const intervalIds = Array.from(new Set((intervals || [])
                    .map((interval) => String(interval?.resourcePlanId || ''))
                    .filter((intervalId) => intervalId !== '')));

                if (intervalIds.length === 0) {
                    return {};
                }

                const query = intervalIds.map((intervalId) => `intervals[]=${encodeURIComponent(intervalId)}`).join('&');
                const response = await fetch(`${resourcePlanBulkUrl}?${query}`);

                if (!response.ok) {
                    const fallbackEntries = await Promise.all(intervalIds.map(async (intervalId) => {
                        const resourcePlan = await loadResourcePlan(intervalId);
                        return [intervalId, resourcePlan];
                    }));

                    return Object.fromEntries(fallbackEntries);
                }

                const payload = await response.json();
                const plans = payload.plans && typeof payload.plans === 'object' ? payload.plans : {};
                const entries = intervalIds.map((intervalId) => {
                    const plan = plans[intervalId] && typeof plans[intervalId] === 'object' ? plans[intervalId] : {};

                    return [intervalId, {
                        intervalId,
                        status: ['DISCUSSION', 'APPROVED', 'CORRECTING'].includes(plan.status) ? plan.status : 'NEW',
                        cells: plan.cells && typeof plan.cells === 'object' ? plan.cells : {},
                    }];
                });

                return Object.fromEntries(entries);
            }

            async function loadWorkingPlan(projectId) {
                const response = await fetch(getPlanUrl(workingPlanGetUrlTemplate, projectId));
                if (!response.ok) {
                    return {rows: [], savedRows: null, hasSaved: false};
                }

                const payload = await response.json();
                return {
                    rows: Array.isArray(payload.rows) ? payload.rows : [],
                    savedRows: Array.isArray(payload.savedRows) ? payload.savedRows : null,
                    hasSaved: payload.hasSaved === true,
                };
            }

            async function persistWorkingPlan() {
                if (!state.activeProject) {
                    return;
                }

                const rows = getCurrentWorkingRowsPayload();
                const response = await fetch(getPlanUrl(workingPlanSaveUrlTemplate, state.activeProject.id), {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({rows}),
                });

                if (!response.ok) {
                    alert('Не удалось сохранить рабочий план');
                    return;
                }

                const payload = await response.json();
                state.savedWorkingPlanRows = Array.isArray(payload.rows) ? payload.rows : rows;
                state.hasSavedWorkingPlan = true;
                state.workingPlanRows = state.savedWorkingPlanRows;
            }

            async function saveCurrentResourcePlanIntervalFromActualTable() {
                const currentBiweeklyIndex = getCurrentBiweeklyIndex();
                const intervalId = state.weeks[currentBiweeklyIndex]?.resourcePlanId ?? null;

                if (!state.activeProject || !intervalId || !['NEW', 'CORRECTING'].includes(state.currentResourcePlan.status)) {
                    return;
                }

                const cells = {...state.currentResourcePlan.cells};
                const projectId = String(state.activeProject.id);
                const projectOrderKey = `${intervalId}::__projects__`;
                const projectSnapshotsKey = `${intervalId}::__project_snapshots__`;
                let projectIds = [];
                let projectSnapshots = [];

                try {
                    projectIds = JSON.parse(String(cells[projectOrderKey] || '[]'));
                } catch (_error) {
                    projectIds = [];
                }

                try {
                    projectSnapshots = JSON.parse(String(cells[projectSnapshotsKey] || '[]'));
                } catch (_error) {
                    projectSnapshots = [];
                }

                if (!projectIds.map((item) => String(item)).includes(projectId)) {
                    projectIds.push(state.activeProject.id);
                }

                if (!projectSnapshots.some((project) => String(project.id) === projectId)) {
                    projectSnapshots.push({
                        id: state.activeProject.id,
                        name: state.activeProject.name,
                    });
                }

                cells[projectOrderKey] = JSON.stringify(projectIds);
                cells[projectSnapshotsKey] = JSON.stringify(projectSnapshots);

                actualTableBody.querySelectorAll('tr').forEach((row) => {
                    const employeeId = String(row.querySelector('.working-employee-select')?.value || '');
                    if (!employeeId) {
                        return;
                    }

                    const cellsByPeriod = row.querySelectorAll('.actual-hour-cell');
                    const targetCell = cellsByPeriod[currentBiweeklyIndex];
                    if (!targetCell) {
                        return;
                    }

                    const input = targetCell.querySelector('.actual-hour-input');
                    const hours = input ? (parseFloat(input.value || '0') || 0) : (parseFloat(targetCell.dataset.hours || '0') || 0);
                    cells[`${intervalId}::${projectId}::${employeeId}`] = String(hours);
                });

                const response = await fetch(getResourcePlanUrl(resourcePlanStatusUrlTemplate, intervalId), {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        status: state.currentResourcePlan.status,
                        cells,
                    }),
                });

                if (!response.ok) {
                    alert('Не удалось сохранить ресурсный план из нижней таблицы');
                    return;
                }

                const payload = await response.json();
                state.currentResourcePlan = {
                    intervalId,
                    status: ['DISCUSSION', 'APPROVED', 'CORRECTING'].includes(payload.status) ? payload.status : 'NEW',
                    cells: payload.cells && typeof payload.cells === 'object' ? payload.cells : cells,
                };
                state.resourcePlansByInterval[String(intervalId)] = state.currentResourcePlan;
                refreshResourcePlanSummary();
            }

            async function savePlan(status) {
                const payload = { status, rows: getCurrentRowsPayload() };
                const response = await fetch(getPlanUrl(planStatusUrlTemplate, state.activeProject.id), { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
                if (!response.ok) { alert('Не удалось обновить статус плана'); return; }
                const data = await response.json(); setStatus(data.status || status);
            }

            async function applyProject(projectId) {
                state.activeProject = projects.find((project) => String(project.id) === String(projectId)) || null;
                const start = state.activeProject?.start ?? '—'; const end = state.activeProject?.end ?? '—';
                state.activeBudget = Number(state.activeProject?.budget ?? 0);
                projectStartDateLabel.textContent = start; projectEndDateLabel.textContent = end; projectBudgetLabel.textContent = String(Math.round(state.activeBudget));
                if (!state.activeProject) { state.status='NEW'; state.actualWeeks=[]; state.actualMatrix={}; state.actualOverrides={}; state.resourcePlanTotals=[]; state.resourcePlansByInterval = {}; state.currentResourcePlan = {intervalId: null, status: 'NEW', cells: {}}; state.workingPlanRows = []; state.savedWorkingPlanRows = null; state.hasSavedWorkingPlan = false; renderTableStructure([]); renderWorkingPlanTable([]); renderChart(); return; }
                const alignedWeeks = buildWeeks();
                const currentBiweeklyIndex = (() => {
                    if (alignedWeeks.length === 0) { return -1; }
                    const now = new Date();
                    now.setHours(12, 0, 0, 0);
                    for (let i = 0; i < alignedWeeks.length; i++) {
                        const start = parseLocalDate(alignedWeeks[i].start);
                        if (!(start instanceof Date)) { continue; }
                        start.setHours(0, 0, 0, 0);
                        const end = new Date(start);
                        end.setDate(end.getDate() + 13);
                        end.setHours(23, 59, 59, 999);
                        if (now >= start && now <= end) { return i; }
                    }
                    return -1;
                })();
                const currentResourcePlanIntervalId = currentBiweeklyIndex >= 0 ? alignedWeeks[currentBiweeklyIndex]?.resourcePlanId ?? null : null;
                const [saved, resourcePlans, workingPlan] = await Promise.all([loadSavedPlan(state.activeProject.id), loadResourcePlans(alignedWeeks), loadWorkingPlan(state.activeProject.id)]);
                state.status = saved.status; state.actualWeeks = []; state.actualMatrix = {}; state.actualOverrides = {}; state.resourcePlansByInterval = resourcePlans; state.currentResourcePlan = resourcePlans[String(currentResourcePlanIntervalId)] || {intervalId: currentResourcePlanIntervalId, status: 'NEW', cells: {}}; state.savedWorkingPlanRows = workingPlan.savedRows; state.hasSavedWorkingPlan = workingPlan.hasSaved;
                renderTableStructure(saved.rows); renderWorkingPlanTable(workingPlan.rows); renderChart();
            }

            document.getElementById('addRowButton').addEventListener('click', function () { createRow(); setStatus(state.status); calculateSummary(); });
            addWorkingRowButton.addEventListener('click', function () { createWorkingRow(); refreshActualSummaryFromRenderedTable(); renderChart(); });
            saveWorkingPlanButton.addEventListener('click', async function () {
                renderChart();
                await persistWorkingPlan();
            });
            sendToResourcePlanButton.addEventListener('click', async function () {
                await saveCurrentResourcePlanIntervalFromActualTable();
            });
            rebuildWorkingPlanChartButton.addEventListener('click', function () {
                renderChart();
            });
            loadSavedWorkingPlanButton.addEventListener('click', async function () {
                if (!state.activeProject) {
                    return;
                }

                const workingPlan = await loadWorkingPlan(state.activeProject.id);
                state.savedWorkingPlanRows = workingPlan.savedRows;
                state.hasSavedWorkingPlan = workingPlan.hasSaved;

                if (Array.isArray(workingPlan.savedRows)) {
                    renderWorkingPlanTable(workingPlan.savedRows);
                    renderChart();
                    return;
                }

                alert('Сохраненный рабочий план не найден');
            });
            document.getElementById('sendForApprovalButton').addEventListener('click', function () { if (state.activeProject) savePlan('SENT'); });
            document.getElementById('approvePlanButton').addEventListener('click', function () { if (isAdmin && state.activeProject) savePlan('APPROVED'); });
            document.getElementById('rejectPlanButton').addEventListener('click', function () { if (isAdmin && state.activeProject) savePlan('REJECTED'); });
            projectSelect.addEventListener('change', function () { applyProject(this.value); });
            tableBody.addEventListener('change', function (event) {
                if (event.target.classList.contains('employee-select')) {
                    updateRowRate(event.target.closest('tr'));
                    calculateSummary();
                    return;
                }

                if (event.target.classList.contains('hour-input')) {
                    calculateSummary();
                }
            });
            tableBody.addEventListener('input', function (event) {
                if (!event.target.classList.contains('hour-input')) {
                    return;
                }

                calculateSummary();
            });
            actualTableBody.addEventListener('input', function (event) {
                if (!event.target.classList.contains('actual-hour-input')) {
                    return;
                }
                const biweeklyIndex = parseInt(String(event.target.dataset.biweeklyIndex || '-1'), 10);
                if (Number.isNaN(biweeklyIndex) || biweeklyIndex < 0) {
                    return;
                }
                const parentCell = event.target.closest('.actual-hour-cell');
                if (parentCell) {
                    parentCell.dataset.hours = String(parseFloat(event.target.value || '0') || 0);
                }
                refreshActualSummaryFromRenderedTable();
                renderChart();
            });
            actualTableBody.addEventListener('change', function (event) {
                if (event.target.classList.contains('working-employee-select')) {
                    updateWorkingRowRate(event.target.closest('tr'));
                    refreshActualSummaryFromRenderedTable();
                    renderChart();
                }
            });
            actualTableBody.addEventListener('click', function (event) {
                if (!event.target.classList.contains('remove-working-row-button')) {
                    return;
                }

                event.target.closest('tr')?.remove();
                refreshActualSummaryFromRenderedTable();
                renderChart();
            });
            tableBody.addEventListener('click', function (event) {
                if (!event.target.classList.contains('remove-row-button')) {
                    return;
                }

                event.target.closest('tr')?.remove();
                calculateSummary();
            });

            if (projectSelect.value) applyProject(projectSelect.value);
            else if (projects.length > 0) { projectSelect.value = String(projects[0].id); applyProject(projectSelect.value); }
            else { renderTableStructure([]); renderWorkingPlanTable([]); renderChart(); }
        })();
    </script>
{% endblock %}
