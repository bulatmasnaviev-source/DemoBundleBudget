{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Менеджмент затрат</h3>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="projectSelect">Проект</label>
                    <select id="projectSelect" class="form-select">
                        {% for project in projects %}
                            <option value="{{ project.id }}">{{ project.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 mb-2">
                <strong>Статус базового плана:</strong>
                <span id="planStatusLabel" class="fw-bold">Новый</span>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button id="sendForApprovalButton" class="btn btn-secondary">Отправить на согласование</button>
                <button id="approvePlanButton" class="btn btn-success" {% if not is_admin %}disabled{% endif %}>Согласовать</button>
                <button id="rejectPlanButton" class="btn btn-warning" {% if not is_admin %}disabled{% endif %}>Отклонено</button>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle" id="budgetTable">
                    <thead id="budgetTableHead"></thead>
                    <tbody id="budgetTableBody"></tbody>
                    <tfoot><tr id="summaryRow"><th colspan="3">Сумма (ставка × часы)</th></tr></tfoot>
                </table>
            </div>

            <div class="d-flex gap-2 mb-3">
                <button id="addRowButton" class="btn btn-outline-primary">+</button>
                <button id="buildChartButton" class="btn btn-success">OK</button>
            </div>

            <div class="table-responsive mt-3">
                <table class="table table-bordered align-middle" id="actualTable">
                    <thead id="actualTableHead"></thead>
                    <tbody id="actualTableBody"></tbody>
                    <tfoot><tr id="actualSummaryRow"><th colspan="2">Факт</th></tr></tfoot>
                </table>
            </div>

            <svg id="budgetChart" width="100%" height="320" viewBox="0 0 1000 320"></svg>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(() => {
    const projects = {{ project_data|json_encode|raw }};
    const employees = {{ employees|json_encode|raw }};
    const isAdmin = {{ is_admin ? 'true' : 'false' }};
    const planGetUrlTemplate = '{{ path('demo_budget_plan_get', {'project': 'PROJECT_ID'}) }}';
    const planStatusUrlTemplate = '{{ path('demo_budget_plan_status', {'project': 'PROJECT_ID'}) }}';
    const actualCostsUrlTemplate = '{{ path('demo_budget_plan_actual_costs', {'project': 'PROJECT_ID'}) }}';

    const STATUS = {
        NEW: {label: 'Новый', color: '#000000', locked: false},
        SENT: {label: 'Отправлено', color: '#6c757d', locked: true},
        APPROVED: {label: 'Согласовано', color: '#198754', locked: true},
        REJECTED: {label: 'Отклонено', color: '#ffc107', locked: false},
    };

    const state = {
        activeProject: null,
        periods: [],
        status: 'NEW',
        actualMatrix: {},
        currentIndex: null,
        resourceApproved: {},
        actualManual: {},
    };

    const employeeMap = new Map(employees.map((employee) => [String(employee.id), employee]));

    const projectSelect = document.getElementById('projectSelect');
    const planStatusLabel = document.getElementById('planStatusLabel');
    const budgetTableHead = document.getElementById('budgetTableHead');
    const budgetTableBody = document.getElementById('budgetTableBody');
    const summaryRow = document.getElementById('summaryRow');
    const actualTableHead = document.getElementById('actualTableHead');
    const actualTableBody = document.getElementById('actualTableBody');
    const actualSummaryRow = document.getElementById('actualSummaryRow');
    const chartSvg = document.getElementById('budgetChart');

    function getUrl(template, id) { return template.replace('PROJECT_ID', String(id)); }
    function formatDay(value) {
        const date = new Date(value);
        return `${String(date.getDate()).padStart(2, '0')}.${String(date.getMonth() + 1).padStart(2, '0')}`;
    }
    function periodLabel(period) { return `${formatDay(period.start)}\n${formatDay(period.end)}`; }

    function setStatus(status) {
        state.status = STATUS[status] ? status : 'NEW';
        planStatusLabel.textContent = STATUS[state.status].label;
        planStatusLabel.style.color = STATUS[state.status].color;
        const locked = STATUS[state.status].locked;
        document.getElementById('addRowButton').disabled = locked;
        budgetTableBody.querySelectorAll('.hour-input, .employee-select, .remove-row').forEach((element) => {
            element.disabled = locked;
        });
    }

    function employeeOptions() {
        if (employees.length === 0) return '<option value="">Нет сотрудников</option>';
        return employees.map((employee) => `<option value="${employee.id}">${employee.name}</option>`).join('');
    }

    function updateRate(row) {
        const employeeId = String(row.querySelector('.employee-select')?.value || '');
        const employee = employeeMap.get(employeeId);
        const rate = Number(employee?.hourlyRate || 0);
        row.dataset.rate = String(rate);
        row.querySelector('.rate-label').textContent = String(Math.round(rate));
    }

    function buildActualRows() {
        const plannedRows = Array.from(budgetTableBody.querySelectorAll('tr')).map((row) => {
            const employeeId = String(row.querySelector('.employee-select')?.value || '');
            return {
                employeeId,
                plannedHours: Array.from(row.querySelectorAll('.hour-input')).map((input) => Number(input.value || 0)),
            };
        });

        const included = new Set(plannedRows.map((row) => row.employeeId));
        const extraRows = Object.keys(state.actualMatrix || {})
            .filter((employeeId) => !included.has(String(employeeId)))
            .map((employeeId) => ({ employeeId: String(employeeId), plannedHours: new Array(state.periods.length).fill(0) }));

        return [...plannedRows, ...extraRows];
    }

    function createBudgetRow(employeeId = null, hours = []) {
        const row = document.createElement('tr');
        row.innerHTML = `<td><select class="form-select employee-select">${employeeOptions()}</select></td><td><span class="rate-label">0</span></td><td><button type="button" class="btn btn-danger remove-row">✕</button></td>`;

        state.periods.forEach((_, index) => {
            const cell = document.createElement('td');
            cell.innerHTML = `<input type="number" min="0" step="0.1" class="form-control hour-input" value="${hours[index] ?? 0}">`;
            row.appendChild(cell);
        });

        budgetTableBody.appendChild(row);
        const select = row.querySelector('.employee-select');
        select.value = String(employeeId ?? employees[0]?.id ?? '');
        updateRate(row);
    }

    function renderHeaders() {
        budgetTableHead.innerHTML = '';
        actualTableHead.innerHTML = '';
        summaryRow.querySelectorAll('.summary-cell').forEach((cell) => cell.remove());
        actualSummaryRow.querySelectorAll('.actual-summary-cell').forEach((cell) => cell.remove());

        const budgetHeader = document.createElement('tr');
        budgetHeader.innerHTML = '<th>Сотрудник</th><th>Ставка</th><th></th>';
        const actualHeader = document.createElement('tr');
        actualHeader.innerHTML = '<th>Сотрудник</th><th>Ставка</th>';

        state.periods.forEach((period, index) => {
            const budgetHeadCell = document.createElement('th');
            budgetHeadCell.style.whiteSpace = 'pre-line';
            budgetHeadCell.textContent = periodLabel(period);
            const actualHeadCell = budgetHeadCell.cloneNode(true);

            if (state.currentIndex === index) {
                budgetHeadCell.style.background = '#fff3cd';
                actualHeadCell.style.background = '#fff3cd';
            }

            budgetHeader.appendChild(budgetHeadCell);
            actualHeader.appendChild(actualHeadCell);

            const summaryCell = document.createElement('td');
            summaryCell.className = 'summary-cell';
            summaryCell.textContent = '0';
            summaryRow.appendChild(summaryCell);

            const actualSummaryCell = document.createElement('td');
            actualSummaryCell.className = 'actual-summary-cell';
            actualSummaryCell.textContent = '0';
            actualSummaryRow.appendChild(actualSummaryCell);
        });

        budgetTableHead.appendChild(budgetHeader);
        actualTableHead.appendChild(actualHeader);
    }

    function calculateBudgetTotals() {
        const totals = new Array(state.periods.length).fill(0);
        budgetTableBody.querySelectorAll('tr').forEach((row) => {
            const rate = Number(row.dataset.rate || 0);
            row.querySelectorAll('.hour-input').forEach((input, index) => {
                totals[index] += rate * Number(input.value || 0);
            });
        });

        summaryRow.querySelectorAll('.summary-cell').forEach((cell, index) => {
            cell.textContent = String(Math.round(totals[index] || 0));
        });

        return totals;
    }

    function getActualCellValue(employeeId, index, plannedValue) {
        const isCurrent = state.currentIndex !== null && index === state.currentIndex;
        const isFuture = state.currentIndex !== null && index > state.currentIndex;

        if (!isCurrent && !isFuture) {
            return Number(state.actualMatrix?.[employeeId]?.[index] || 0);
        }

        const approvedValue = Number(state.resourceApproved?.[employeeId] || 0);
        if (isCurrent && approvedValue > 0) {
            return approvedValue;
        }

        const manualKey = `${employeeId}_${index}`;
        if (Object.prototype.hasOwnProperty.call(state.actualManual, manualKey)) {
            return Number(state.actualManual[manualKey] || 0);
        }

        return Number(plannedValue || 0);
    }

    function renderActualTable() {
        actualTableBody.innerHTML = '';
        const totals = new Array(state.periods.length).fill(0);
        const rows = buildActualRows();

        rows.forEach((rowData) => {
            const employeeId = String(rowData.employeeId);
            const employee = employeeMap.get(employeeId);
            const rate = Number(employee?.hourlyRate || 0);
            const name = employee?.name || `Пользователь_${employeeId}`;

            const row = document.createElement('tr');
            row.innerHTML = `<td>${name}</td><td>${Math.round(rate)}</td>`;

            state.periods.forEach((_, index) => {
                const plannedValue = rowData.plannedHours[index] || 0;
                const value = getActualCellValue(employeeId, index, plannedValue);
                const isCurrent = state.currentIndex !== null && index === state.currentIndex;
                const isFuture = state.currentIndex !== null && index > state.currentIndex;

                const cell = document.createElement('td');
                if (isCurrent) {
                    cell.style.background = '#fff3cd';
                }

                if (isCurrent || isFuture) {
                    const input = document.createElement('input');
                    input.type = 'number';
                    input.step = '0.1';
                    input.min = '0';
                    input.className = 'form-control actual-input';
                    input.dataset.employeeId = employeeId;
                    input.dataset.index = String(index);
                    input.value = String(value);
                    if (isCurrent && Number(state.resourceApproved?.[employeeId] || 0) > 0) {
                        input.disabled = true;
                    }
                    cell.appendChild(input);
                } else {
                    cell.textContent = String(Math.round(value));
                }

                totals[index] += rate * Number(value || 0);
                row.appendChild(cell);
            });

            actualTableBody.appendChild(row);
        });

        actualSummaryRow.querySelectorAll('.actual-summary-cell').forEach((cell, index) => {
            cell.textContent = String(Math.round(totals[index] || 0));
        });

        return totals;
    }

    function drawChart(budgetTotals, actualTotals) {
        if (state.periods.length === 0) {
            chartSvg.innerHTML = '';
            return;
        }

        const budget = Number(state.activeProject?.budget || 0);
        const buildSeries = (totals) => {
            const values = [budget];
            totals.forEach((total) => values.push(values[values.length - 1] - total));
            return values;
        };

        const planned = buildSeries(budgetTotals);
        const actual = buildSeries(actualTotals);
        const labels = state.periods.map((period) => `${formatDay(period.start)}-${formatDay(period.end)}`);
        labels.push(`${labels[labels.length - 1]}+1`);

        const width = 1000;
        const height = 320;
        const padding = { left: 70, right: 20, top: 20, bottom: 70 };
        const innerWidth = width - padding.left - padding.right;
        const innerHeight = height - padding.top - padding.bottom;

        const allValues = [...planned, ...actual, 0];
        const min = Math.min(...allValues);
        const max = Math.max(...allValues);
        const range = Math.max(max - min, 1);

        const pointX = (index, count) => padding.left + (index * innerWidth) / Math.max(count - 1, 1);
        const pointY = (value) => padding.top + ((max - value) / range) * innerHeight;

        const points = (values) => values.map((value, index) => `${pointX(index, values.length)},${pointY(value)}`).join(' ');

        chartSvg.setAttribute('viewBox', `0 0 ${width} ${height}`);
        chartSvg.innerHTML = `
            <line x1="${padding.left}" y1="${padding.top}" x2="${padding.left}" y2="${height - padding.bottom}" stroke="#444"/>
            <line x1="${padding.left}" y1="${height - padding.bottom}" x2="${width - padding.right}" y2="${height - padding.bottom}" stroke="#444"/>
            <polyline fill="none" stroke="#206bc4" stroke-width="2" points="${points(planned)}"/>
            <polyline fill="none" stroke="#000000" stroke-width="2" points="${points(actual)}"/>
            ${labels.map((label, index) => `<text x="${pointX(index, labels.length)}" y="${height - padding.bottom + 18}" text-anchor="middle" font-size="10">${label}</text>`).join('')}
        `;
    }

    function getRowsPayload() {
        return Array.from(budgetTableBody.querySelectorAll('tr')).map((row) => ({
            employeeId: row.querySelector('.employee-select')?.value ?? null,
            hours: Array.from(row.querySelectorAll('.hour-input')).map((input) => input.value),
        }));
    }

    async function loadSavedPlan(projectId) {
        const response = await fetch(getUrl(planGetUrlTemplate, projectId));
        if (!response.ok) return {status: 'NEW', rows: []};
        return response.json();
    }

    async function loadActual(projectId) {
        const response = await fetch(getUrl(actualCostsUrlTemplate, projectId));
        if (!response.ok) return {weeks: [], matrix: {}, currentIndex: null, resourceApproved: {}};
        return response.json();
    }

    async function savePlan(status) {
        if (!state.activeProject) return;
        const response = await fetch(getUrl(planStatusUrlTemplate, state.activeProject.id), {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ status, rows: getRowsPayload() }),
        });
        if (!response.ok) return;
        const payload = await response.json();
        setStatus(payload.status || status);
    }

    function renderEverything() {
        const budgetTotals = calculateBudgetTotals();
        const actualTotals = renderActualTable();
        drawChart(budgetTotals, actualTotals);
    }

    async function applyProject(projectId) {
        state.activeProject = projects.find((project) => String(project.id) === String(projectId)) || null;
        if (!state.activeProject) return;

        state.actualManual = {};
        const [saved, actual] = await Promise.all([loadSavedPlan(projectId), loadActual(projectId)]);
        state.periods = Array.isArray(actual.weeks) ? actual.weeks : [];
        state.actualMatrix = actual.matrix || {};
        state.currentIndex = Number.isInteger(actual.currentIndex) ? actual.currentIndex : null;
        state.resourceApproved = actual.resourceApproved || {};

        renderHeaders();
        budgetTableBody.innerHTML = '';

        const rows = Array.isArray(saved.rows) && saved.rows.length > 0 ? saved.rows : [{}, {}, {}];
        rows.forEach((row) => createBudgetRow(row.employeeId ?? null, Array.isArray(row.hours) ? row.hours : []));

        setStatus(saved.status || 'NEW');
        renderEverything();
    }

    document.getElementById('addRowButton').addEventListener('click', () => {
        createBudgetRow();
        setStatus(state.status);
        renderEverything();
    });
    document.getElementById('buildChartButton').addEventListener('click', renderEverything);
    document.getElementById('sendForApprovalButton').addEventListener('click', () => savePlan('SENT'));
    document.getElementById('approvePlanButton').addEventListener('click', () => { if (isAdmin) savePlan('APPROVED'); });
    document.getElementById('rejectPlanButton').addEventListener('click', () => { if (isAdmin) savePlan('REJECTED'); });

    projectSelect.addEventListener('change', () => applyProject(projectSelect.value));

    budgetTableBody.addEventListener('change', (event) => {
        if (event.target.classList.contains('employee-select')) {
            updateRate(event.target.closest('tr'));
            renderEverything();
        }
    });
    budgetTableBody.addEventListener('input', (event) => {
        if (event.target.classList.contains('hour-input')) {
            renderEverything();
        }
    });
    budgetTableBody.addEventListener('click', (event) => {
        if (event.target.classList.contains('remove-row')) {
            event.target.closest('tr').remove();
            renderEverything();
        }
    });

    actualTableBody.addEventListener('input', (event) => {
        if (!event.target.classList.contains('actual-input')) return;
        const employeeId = String(event.target.dataset.employeeId || '');
        const index = String(event.target.dataset.index || '0');
        state.actualManual[`${employeeId}_${index}`] = Number(event.target.value || 0);
        const budgetTotals = calculateBudgetTotals();
        const actualTotals = renderActualTable();
        drawChart(budgetTotals, actualTotals);
    });

    if (projectSelect.value) {
        applyProject(projectSelect.value);
    }
})();
</script>
{% endblock %}
