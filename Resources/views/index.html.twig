{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header"><h3 class="card-title">Менеджмент затрат</h3></div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="projectSelect">Проект</label>
                    <select id="projectSelect" class="form-select">
                        {% for project in projects %}
                            <option value="{{ project.id }}">{{ project.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <strong>Статус базового плана:</strong><span id="planStatusLabel" class="fw-bold">Новый</span>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button id="sendForApprovalButton" class="btn btn-secondary">Отправить на согласование</button>
                <button id="approvePlanButton" class="btn btn-success" {% if not is_admin %}disabled{% endif %}>Согласовать</button>
                <button id="rejectPlanButton" class="btn btn-warning" {% if not is_admin %}disabled{% endif %}>Отклонено</button>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle" id="budgetTable">
                    <thead id="budgetTableHead"></thead>
                    <tbody id="budgetTableBody"></tbody>
                    <tfoot><tr id="summaryRow"><th colspan="3">Сумма (ставка × часы)</th></tr></tfoot>
                </table>
            </div>
            <div class="d-flex gap-2 mb-3">
                <button id="addRowButton" class="btn btn-outline-primary">+</button>
                <button id="buildChartButton" class="btn btn-success">OK</button>
            </div>

            <div class="table-responsive mt-3">
                <table class="table table-bordered align-middle" id="actualTable">
                    <thead id="actualTableHead"></thead>
                    <tbody id="actualTableBody"></tbody>
                    <tfoot><tr id="actualSummaryRow"><th colspan="3">Факт</th></tr></tfoot>
                </table>
            </div>
            <svg id="budgetChart" width="100%" height="260"></svg>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(() => {
const projects = {{ project_data|json_encode|raw }};
const employees = {{ employees|json_encode|raw }};
const isAdmin = {{ is_admin ? 'true' : 'false' }};
const planGetUrlTemplate = '{{ path('demo_budget_plan_get', {'project': 'PROJECT_ID'}) }}';
const planStatusUrlTemplate = '{{ path('demo_budget_plan_status', {'project': 'PROJECT_ID'}) }}';
const actualCostsUrlTemplate = '{{ path('demo_budget_plan_actual_costs', {'project': 'PROJECT_ID'}) }}';
const STATUS={NEW:{label:'Новый',locked:false,color:'#000'},SENT:{label:'Отправлено',locked:true,color:'#6c757d'},APPROVED:{label:'Согласовано',locked:true,color:'#198754'},REJECTED:{label:'Отклонено',locked:false,color:'#ffc107'}};
const state={periods:[],status:'NEW',activeProject:null,actualMatrix:{},currentIndex:null,resourceApproved:{},actualManual:{}};
const $=id=>document.getElementById(id);
const employeeMap=new Map(employees.map(e=>[String(e.id),e]));

const fmt=(d)=>`${String(d.getDate()).padStart(2,'0')}.${String(d.getMonth()+1).padStart(2,'0')}`;
const getMonday=(date)=>{const r=new Date(date);const d=r.getDay();r.setDate(r.getDate()+(d===0?-6:1-d));r.setHours(0,0,0,0);return r};
const getSunday=(date)=>{const r=getMonday(date);r.setDate(r.getDate()+6);r.setHours(23,59,59,999);return r};
function buildPeriods(){
 if(!state.activeProject?.start||!state.activeProject?.end) return [];
 const start=new Date(state.activeProject.start), end=new Date(state.activeProject.end);
 const s=getMonday(start); s.setDate(s.getDate()-7);
 const e=getSunday(end); e.setDate(e.getDate()+14);
 const out=[]; const c=new Date(s);
 while(c<=e){const d2=new Date(c);d2.setDate(d2.getDate()+13); out.push({start:c.toISOString().slice(0,10), end:d2.toISOString().slice(0,10), label:`${fmt(c)}\n${fmt(d2)}`}); c.setDate(c.getDate()+14);} return out;
}
function employeeOptions(){return employees.map(e=>`<option value="${e.id}">${e.name}</option>`).join('')}
function setStatus(st){state.status=STATUS[st]?st:'NEW'; $('planStatusLabel').textContent=STATUS[state.status].label; $('planStatusLabel').style.color=STATUS[state.status].color; const lock=STATUS[state.status].locked; $('addRowButton').disabled=lock; document.querySelectorAll('#budgetTable .hour-input,#budgetTable .employee-select,.remove-row').forEach(el=>el.disabled=lock);} 
function renderHeaders(){
 $('budgetTableHead').innerHTML='';$('actualTableHead').innerHTML='';
 $('summaryRow').querySelectorAll('.summary-cell').forEach(e=>e.remove()); $('actualSummaryRow').querySelectorAll('.actual-summary-cell').forEach(e=>e.remove());
 const br=document.createElement('tr'); br.innerHTML='<th>Сотрудник</th><th>Ставка</th><th></th>';
 const ar=document.createElement('tr'); ar.innerHTML='<th>Сотрудник</th><th>Ставка</th><th></th>';
 state.periods.forEach((p,idx)=>{const h=document.createElement('th'); h.style.whiteSpace='pre-line'; h.textContent=p.label; br.appendChild(h.cloneNode(true)); ar.appendChild(h); const s=document.createElement('td'); s.className='summary-cell'; s.textContent='0'; $('summaryRow').appendChild(s); const s2=document.createElement('td'); s2.className='actual-summary-cell'; s2.textContent='0'; $('actualSummaryRow').appendChild(s2); if(state.currentIndex===idx){ar.lastChild.style.background='#fff3cd'; br.lastChild.style.background='#fff3cd';}});
 $('budgetTableHead').appendChild(br); $('actualTableHead').appendChild(ar);
}
function createRow(empId=null,hours=[]){const tr=document.createElement('tr'); tr.innerHTML=`<td><select class="form-select employee-select">${employeeOptions()}</select></td><td><span class="rate-label">0</span></td><td><button class="btn btn-danger remove-row">✕</button></td>`; state.periods.forEach((_,i)=>{const td=document.createElement('td'); td.innerHTML=`<input class="form-control hour-input" type="number" min="0" step="0.1" value="${hours[i]??0}">`; tr.appendChild(td);}); $('budgetTableBody').appendChild(tr); const sel=tr.querySelector('.employee-select'); sel.value=String(empId??employees[0]?.id??''); updateRate(tr);} 
function updateRate(tr){const e=employeeMap.get(String(tr.querySelector('.employee-select').value)); tr.dataset.rate=String(Number(e?.hourlyRate||0)); tr.querySelector('.rate-label').textContent=String(Math.round(Number(e?.hourlyRate||0)));}
function payloadRows(){return [...$('budgetTableBody').querySelectorAll('tr')].map(r=>({employeeId:r.querySelector('.employee-select').value,hours:[...r.querySelectorAll('.hour-input')].map(i=>i.value)}));}
function totals(){const t=new Array(state.periods.length).fill(0); [...$('budgetTableBody').querySelectorAll('tr')].forEach(r=>{const rate=Number(r.dataset.rate||0); [...r.querySelectorAll('.hour-input')].forEach((i,idx)=>t[idx]+=rate*Number(i.value||0));}); $('summaryRow').querySelectorAll('.summary-cell').forEach((c,i)=>c.textContent=Math.round(t[i]||0)); return t;}
function syncActual(){
 $('actualTableBody').innerHTML=''; const t=new Array(state.periods.length).fill(0);
 [...$('budgetTableBody').querySelectorAll('tr')].forEach(r=>{
   const empId=String(r.querySelector('.employee-select').value); const emp=employeeMap.get(empId)||{name:`Пользователь_${empId}`,hourlyRate:0}; const tr=document.createElement('tr');
   tr.innerHTML=`<td>${emp.name}</td><td>${Math.round(Number(emp.hourlyRate||0))}</td><td><button class="btn btn-danger actual-remove-row">✕</button></td>`;
   state.periods.forEach((_,idx)=>{const td=document.createElement('td'); const current=state.currentIndex!==null&&idx===state.currentIndex; const future=state.currentIndex!==null&&idx>state.currentIndex; if(current||future){
      const fromPlan=Number(r.querySelectorAll('.hour-input')[idx]?.value||0);
      const approved=Number(state.resourceApproved?.[empId]||0);
      const value=current&&approved>0?approved:(state.actualManual[`${empId}_${idx}`]??fromPlan);
      const input=document.createElement('input'); input.type='number'; input.step='0.1'; input.min='0'; input.className='form-control actual-input'; input.dataset.emp=empId; input.dataset.idx=idx; input.value=value;
      if(current){td.style.background='#fff3cd'; if(approved>0){input.disabled=true;}}
      td.appendChild(input); t[idx]+=Number(value)*Number(emp.hourlyRate||0);
   } else {
      const v=Number(state.actualMatrix?.[empId]?.[idx]||0); td.textContent=Math.round(v); t[idx]+=v*Number(emp.hourlyRate||0);
   }
   tr.appendChild(td);
   });
   $('actualTableBody').appendChild(tr);
 });
 $('actualSummaryRow').querySelectorAll('.actual-summary-cell').forEach((c,i)=>c.textContent=Math.round(t[i]||0));
 drawChart(totals(),t);
}
function drawChart(plan,actual){const svg=$('budgetChart'); if(plan.length===0){svg.innerHTML='';return;} const w=1000,h=260,p={l:70,r:20,t:20,b:40},max=Math.max(...plan,...actual,1),step=(w-p.l-p.r)/Math.max(plan.length,1); const to=(vals,color)=>vals.map((v,i)=>`${p.l+i*step},${h-p.b-(v/max)*(h-p.t-p.b)}`).join(' '); svg.setAttribute('viewBox',`0 0 ${w} ${h}`); svg.innerHTML=`<polyline fill="none" stroke="#206bc4" stroke-width="2" points="${to(plan)}"/><polyline fill="none" stroke="#000" stroke-width="2" points="${to(actual)}"/>`;}

async function loadSavedPlan(pid){const r=await fetch(planGetUrlTemplate.replace('PROJECT_ID',pid)); if(!r.ok) return {status:'NEW',rows:[]}; return r.json();}
async function loadActual(pid){const r=await fetch(actualCostsUrlTemplate.replace('PROJECT_ID',pid)); if(!r.ok) return {matrix:{}}; return r.json();}
async function savePlan(status){const r=await fetch(planStatusUrlTemplate.replace('PROJECT_ID',state.activeProject.id),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({status,rows:payloadRows()})}); if(r.ok){const p=await r.json(); setStatus(p.status);}}
async function applyProject(pid){state.activeProject=projects.find(p=>String(p.id)===String(pid))||null; if(!state.activeProject) return; const [saved,actual]=await Promise.all([loadSavedPlan(pid),loadActual(pid)]); state.periods=buildPeriods(); state.actualMatrix=actual.matrix||{}; state.currentIndex=Number.isInteger(actual.currentIndex)?actual.currentIndex:null; state.resourceApproved=actual.resourceApproved||{}; renderHeaders(); $('budgetTableBody').innerHTML=''; (saved.rows?.length?saved.rows:[{}, {}, {}]).forEach((r)=>createRow(r.employeeId??null,Array.isArray(r.hours)?r.hours:[])); setStatus(saved.status||'NEW'); totals(); syncActual();}

$('projectSelect').addEventListener('change',e=>applyProject(e.target.value));
$('addRowButton').addEventListener('click',()=>{createRow(); setStatus(state.status); totals(); syncActual();});
$('buildChartButton').addEventListener('click',()=>syncActual());
$('sendForApprovalButton').addEventListener('click',()=>state.activeProject&&savePlan('SENT'));
$('approvePlanButton').addEventListener('click',()=>isAdmin&&state.activeProject&&savePlan('APPROVED'));
$('rejectPlanButton').addEventListener('click',()=>isAdmin&&state.activeProject&&savePlan('REJECTED'));
$('budgetTableBody').addEventListener('change',e=>{if(e.target.classList.contains('employee-select')){updateRate(e.target.closest('tr')); totals(); syncActual();}});
$('budgetTableBody').addEventListener('input',e=>{if(e.target.classList.contains('hour-input')){totals(); syncActual();}});
$('budgetTableBody').addEventListener('click',e=>{if(e.target.classList.contains('remove-row')){e.target.closest('tr').remove(); totals(); syncActual();}});
$('actualTableBody').addEventListener('input',e=>{if(e.target.classList.contains('actual-input')){state.actualManual[`${e.target.dataset.emp}_${e.target.dataset.idx}`]=Number(e.target.value||0); syncActual();}});
$('actualTableBody').addEventListener('click',e=>{if(e.target.classList.contains('actual-remove-row')){const row=e.target.closest('tr');const name=row.firstChild.textContent.trim(); const budgetRow=[...$('budgetTableBody').querySelectorAll('tr')].find(r=>{const id=r.querySelector('.employee-select').value; return (employeeMap.get(String(id))?.name||`Пользователь_${id}`)===name}); if(budgetRow){budgetRow.remove(); totals(); syncActual();}}});
if($('projectSelect').value){applyProject($('projectSelect').value);} 
})();
</script>
{% endblock %}
